{
  "sections": {
    "main": {
      "type": "product",
      "blocks": {
        "media": {
          "type": "product_media",
          "settings": {
            "media_layout": "grid",
            "media_ratio": "natural",
            "media_grid_gap": 8,
            "mobile_gallery_layout": "slider",
            "mobile_gallery_controls": "dots",
            "enable_image_zoom": true,
            "image_zoom_level": 3,
            "video_autoplay": false,
            "video_loop": true
          }
        },
        "vendor": {
          "type": "vendor"
        },
        "title": {
          "type": "product_title",
          "settings": {
            "style": "h1"
          }
        },
        "price": {
          "type": "price"
        },
        "variant_picker": {
          "type": "variant_picker"
        },
        "quantity": {
          "type": "quantity_selector"
        },
        "buy_buttons": {
          "type": "buy_buttons"
        },
        "description": {
          "type": "description"
        },
        "ingredients": {
          "type": "ingredients"
        },
        "skin_profile": {
          "type": "skin_profile"
        },
        "usage": {
          "type": "usage"
        },
        "rating": {
          "type": "rating"
        },
        "pickup_availability": {
          "type": "pickup_availability"
        }
      },
      "block_order": [
        "media",
        "vendor",
        "title",
        "rating",
        "price",
        "variant_picker",
        "quantity",
        "buy_buttons",
        "pickup_availability",
        "description",
        "ingredients",
        "skin_profile",
        "usage"
      ],
      "settings": {
        "product_info_width": 40,
        "sticky_add_to_cart": true,
        "show_selling_plans": true,
        "show_payment_terms": true,
        "show_pickup_availability": true
      }
    },
    "related": {
      "type": "product-recommendations",
      "settings": {
        "heading": "Complete the ritual",
        "intent": "related"
      }
    },
    "complementary": {
      "type": "product-recommendations",
      "settings": {
        "heading": "Pairs well with",
        "intent": "complementary"
      }
    }
  },
  "order": [
    "main",
    "related",
    "complementary"
  ]
