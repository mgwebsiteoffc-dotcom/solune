<section class="page-width section-space" aria-labelledby="InstagramStoriesTitle-{{ section.id }}">
  <div class="section-intro instagram-stories__intro">
    <div class="section-intro__copy">
      {% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
      <h2 id="InstagramStoriesTitle-{{ section.id }}" class="section-heading">{{ section.settings.heading | escape }}</h2>
    </div>
    {% if section.settings.profile_url != blank %}
      <a class="button button--text" href="{{ section.settings.profile_url }}">
        {{ 'social.follow_instagram' | t }}{% if section.settings.profile_handle != blank %} {{ section.settings.profile_handle | escape }}{% endif %}
      </a>
    {% endif %}
  </div>

  <div class="instagram-stories__list" role="list">
    {% for block in section.blocks %}
      {% assign story_image_alt = block.settings.image.alt | default: block.settings.caption | default: shop.name %}
      {% assign story_demo_asset = 'demo-ingredient.jpg' %}
      {% case forloop.index0 %}
        {% when 1 %}{% assign story_demo_asset = 'demo-product.jpg' %}
        {% when 2 %}{% assign story_demo_asset = 'demo-hero.jpg' %}
        {% when 3 %}{% assign story_demo_asset = 'demo-ingredient.jpg' %}
      {% endcase %}
      {% if block.settings.link != blank %}
        <a class="instagram-story" role="listitem" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>
      {% else %}
        <article class="instagram-story" role="listitem" {{ block.shopify_attributes }}>
      {% endif %}
        <span class="instagram-story__image">
          {% if block.settings.image != blank %}
            {{ block.settings.image | image_url: width: 480 | image_tag: alt: story_image_alt, widths: '160, 240, 320, 480', sizes: '112px', loading: 'lazy' }}
          {% else %}
            <img src="{{ story_demo_asset | asset_url }}" alt="{{ 'sections.instagram_stories.demo_image_alt' | t | escape }}" width="480" height="480" loading="lazy" decoding="async">
            <span class="demo-media-label">{{ 'general.demo_image_label' | t }}</span>
          {% endif %}
        </span>
        <span class="instagram-story__caption">{% if block.settings.caption != blank %}{{ block.settings.caption | escape }}{% else %}{{ 'sections.instagram_stories.preview_story' | t }}{% endif %}</span>
        {% if section.settings.profile_handle != blank %}<span class="instagram-story__handle">{{ section.settings.profile_handle | escape }}</span>{% endif %}
      {% if block.settings.link != blank %}</a>{% else %}</article>{% endif %}
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.instagram_stories.name",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "t:sections.instagram_stories.settings.eyebrow", "default": "FROM THE STUDIO" },
    { "type": "text", "id": "heading", "label": "t:sections.instagram_stories.settings.heading", "default": "Stories from the ritual." },
    { "type": "text", "id": "profile_handle", "label": "t:sections.instagram_stories.settings.profile_handle" },
    { "type": "url", "id": "profile_url", "label": "t:sections.instagram_stories.settings.profile_url", "info": "t:sections.instagram_stories.settings.profile_url_info" }
  ],
  "blocks": [
    {
      "type": "story",
      "name": "t:sections.instagram_stories.blocks.story",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "t:sections.instagram_stories.settings.image" },
        { "type": "text", "id": "caption", "label": "t:sections.instagram_stories.settings.caption", "default": "Preview story" },
        { "type": "url", "id": "link", "label": "t:sections.instagram_stories.settings.link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.instagram_stories.name",
      "blocks": [
        { "type": "story" },
        { "type": "story" },
        { "type": "story" },
        { "type": "story" }
      ]
    }
  ]
}
{% endschema %}
