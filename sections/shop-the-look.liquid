{% assign look_image = section.settings.image %}
{% assign look_image_alt = section.settings.image_alt | default: look_image.alt | default: section.settings.heading | default: shop.name %}
<section
  class="page-width section-space shop-the-look"
  data-image-position="{{ section.settings.image_position | default: 'left' | escape }}"
  data-image-ratio="{{ section.settings.image_ratio | default: 'landscape' | escape }}"
  aria-labelledby="ShopTheLookTitle-{{ section.id }}"
>
  <div class="section-intro shop-the-look__intro">
    <div class="section-intro__copy">
      {% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
      <h2 id="ShopTheLookTitle-{{ section.id }}" class="section-heading">{{ section.settings.heading | escape }}</h2>
      {% if section.settings.body != blank %}<div class="section-intro__body rich-text">{{ section.settings.body }}</div>{% endif %}
    </div>
  </div>

  <div class="shop-the-look__layout">
    <div class="shop-the-look__visual">
      {% if look_image != blank %}
        {{ look_image | image_url: width: 1800 | image_tag: alt: look_image_alt, widths: '480, 640, 800, 1000, 1200, 1600, 1800', sizes: '(min-width: 1025px) 58vw, 100vw', loading: 'lazy' }}
      {% else %}
        <img
          src="{{ 'demo-hero.jpg' | asset_url }}"
          alt="{{ 'sections.shop_the_look.demo_image_alt' | t | escape }}"
          width="1400"
          height="940"
          loading="lazy"
          decoding="async"
        >
        <span class="demo-media-label">{{ 'general.demo_image_label' | t }}</span>
      {% endif %}

      <div class="shop-the-look__hotspots" role="group" aria-label="{{ 'sections.shop_the_look.hotspots_label' | t | escape }}">
        {% for block in section.blocks %}
          {% assign look_product = block.settings.product %}
          {% if look_product != blank %}
            <a
              class="shop-the-look__hotspot"
              href="{{ look_product.url | escape }}"
              style="--hotspot-x: {{ block.settings.horizontal_position }}%; --hotspot-y: {{ block.settings.vertical_position }}%;"
              aria-label="{{ 'sections.shop_the_look.view_product' | t: product: look_product.title | escape }}"
            >
              <span aria-hidden="true">{{ forloop.index }}</span>
            </a>
          {% else %}
            <span class="shop-the-look__hotspot shop-the-look__hotspot--demo" style="--hotspot-x: {{ block.settings.horizontal_position }}%; --hotspot-y: {{ block.settings.vertical_position }}%;" aria-hidden="true">
              <span>{{ forloop.index }}</span>
            </span>
          {% endif %}
        {% endfor %}
      </div>
    </div>

    {% if section.blocks.size > 0 %}
      <ol class="shop-the-look__products" aria-label="{{ 'sections.shop_the_look.products_label' | t | escape }}">
        {% for block in section.blocks %}
          {% assign look_product = block.settings.product %}
          <li class="shop-the-look__product" {{ block.shopify_attributes }}>
            {% if look_product != blank %}
              {% render 'product-card', product: look_product, show_vendor_override: section.settings.show_vendor, show_quick_add: section.settings.show_quick_add, loading: 'lazy' %}
            {% else %}
              <article class="shop-the-look__placeholder">
                <div class="shop-the-look__placeholder-media">
                  <img src="{{ 'demo-product.jpg' | asset_url }}" alt="{{ 'sections.shop_the_look.demo_product_alt' | t | escape }}" width="480" height="600" loading="lazy" decoding="async">
                  <span class="demo-media-label">{{ 'general.demo_image_label' | t }}</span>
                </div>
                <div class="shop-the-look__placeholder-copy">
                  <p class="eyebrow">{{ 'sections.shop_the_look.look_item' | t: number: forloop.index }}</p>
                  <h3>{{ 'sections.shop_the_look.choose_product' | t }}</h3>
                  <p>{{ 'sections.shop_the_look.choose_product_info' | t }}</p>
                </div>
              </article>
            {% endif %}
          </li>
        {% endfor %}
      </ol>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.shop_the_look.name",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "t:sections.shop_the_look.settings.eyebrow", "default": "RITUAL, IN CONTEXT" },
    { "type": "text", "id": "heading", "label": "t:sections.shop_the_look.settings.heading", "default": "Shop the ritual" },
    { "type": "richtext", "id": "body", "label": "t:sections.shop_the_look.settings.body", "default": "<p>Explore the products selected for this everyday routine.</p>" },
    { "type": "image_picker", "id": "image", "label": "t:sections.shop_the_look.settings.image" },
    { "type": "text", "id": "image_alt", "label": "t:sections.shop_the_look.settings.image_alt" },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:sections.shop_the_look.settings.image_ratio",
      "options": [
        { "value": "landscape", "label": "t:sections.shop_the_look.options.image_ratio.landscape" },
        { "value": "square", "label": "t:sections.shop_the_look.options.image_ratio.square" },
        { "value": "portrait", "label": "t:sections.shop_the_look.options.image_ratio.portrait" }
      ],
      "default": "landscape"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "t:sections.shop_the_look.settings.image_position",
      "options": [
        { "value": "left", "label": "t:sections.shop_the_look.options.image_position.left" },
        { "value": "right", "label": "t:sections.shop_the_look.options.image_position.right" }
      ],
      "default": "left"
    },
    { "type": "checkbox", "id": "show_vendor", "label": "t:sections.shop_the_look.settings.show_vendor", "default": false },
    { "type": "checkbox", "id": "show_quick_add", "label": "t:sections.shop_the_look.settings.show_quick_add", "default": true }
  ],
  "blocks": [
    {
      "type": "look_product",
      "name": "t:sections.shop_the_look.blocks.product",
      "settings": [
        { "type": "product", "id": "product", "label": "t:sections.shop_the_look.blocks.product_setting" },
        { "type": "range", "id": "horizontal_position", "label": "t:sections.shop_the_look.blocks.horizontal_position", "min": 0, "max": 100, "step": 1, "default": 35 },
        { "type": "range", "id": "vertical_position", "label": "t:sections.shop_the_look.blocks.vertical_position", "min": 0, "max": 100, "step": 1, "default": 40 }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.shop_the_look.name",
      "blocks": [
        { "type": "look_product", "settings": { "horizontal_position": 31, "vertical_position": 38 } },
        { "type": "look_product", "settings": { "horizontal_position": 65, "vertical_position": 54 } },
        { "type": "look_product", "settings": { "horizontal_position": 42, "vertical_position": 77 } }
      ]
    }
  ]
}
{% endschema %}
