<section class="page-width section-space--small password-page" aria-labelledby="PasswordTitle-{{ section.id }}">
  <a class="site-brand__wordmark password-page__brand" href="{{ routes.root_url }}">{{ shop.name | escape }}</a>
  <h1 id="PasswordTitle-{{ section.id }}" class="section-heading">{{ 'password.title' | t }}</h1>
  {% if shop.password_message != blank %}<p class="section-intro__body">{{ shop.password_message | escape }}</p>{% endif %}

  {% form 'storefront_password' %}
    {% if form.errors %}<div class="form-status" role="alert">{{ form.errors | default_errors }}</div>{% endif %}
    <div class="field">
      <label for="PasswordInput-{{ section.id }}">{{ 'password.password' | t }}</label>
      <input id="PasswordInput-{{ section.id }}" type="password" name="password" autocomplete="current-password" required>
    </div>
    <button class="button" type="submit">{{ 'password.enter' | t }}</button>
  {% endform %}
</section>

{% schema %}
{
  "name": "t:general.password",
  "settings": []
}
{% endschema %}
