{% assign contact_form_id = 'ContactForm-' | append: section.id %}
{% assign contact_errors_id = contact_form_id | append: '-errors' %}
{% render 'breadcrumbs', mode: 'visible' %}
<section id="ContactPage-{{ section.id }}" class="page-width section-space--small contact-page" aria-labelledby="ContactTitle-{{ section.id }}">
  <header class="contact-page__header">
    {% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
    <h1 id="ContactTitle-{{ section.id }}" class="section-heading">{{ section.settings.heading | escape }}</h1>
    {% if section.settings.body != blank %}<div class="contact-page__intro rich-text">{{ section.settings.body }}</div>{% endif %}
  </header>

  <div class="contact-page__layout">
    <aside class="contact-page__details"{% if section.settings.details_heading != blank %} aria-labelledby="ContactDetailsTitle-{{ section.id }}"{% else %} aria-label="{{ 'contact.details_label' | t | escape }}"{% endif %}>
      {% if section.settings.details_heading != blank %}<h2 id="ContactDetailsTitle-{{ section.id }}" class="contact-page__details-heading">{{ section.settings.details_heading | escape }}</h2>{% endif %}
      {% if section.settings.details_body != blank %}<div class="contact-page__details-copy rich-text">{{ section.settings.details_body }}</div>{% endif %}

      {% assign has_contact_details = false %}
      {% for block in section.blocks %}
        {% if block.settings.value != blank %}{% assign has_contact_details = true %}{% endif %}
      {% endfor %}
      {% if has_contact_details %}
        <div class="contact-page__methods">
          {% for block in section.blocks %}
            {% assign detail_value = block.settings.value | strip %}
            {% if detail_value != blank %}
              {% assign detail_kind = block.settings.kind | default: 'email' %}
              {% assign detail_label_key = 'contact.details.' | append: detail_kind %}
              {% assign detail_label = detail_label_key | t %}
              {% assign detail_heading = block.settings.heading | default: detail_label %}
              <article class="contact-detail" {{ block.shopify_attributes }}>
                <span class="contact-detail__icon" aria-hidden="true">
                  {% case detail_kind %}
                    {% when 'email' %}
                      <svg viewBox="0 0 24 24" focusable="false"><rect x="3.25" y="5.25" width="17.5" height="13.5" rx="2" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="m4.5 7 7.5 5.75L19.5 7" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    {% when 'phone' %}
                      <svg viewBox="0 0 24 24" focusable="false"><path d="M7.2 3.8h2.6l1.25 4.05-1.85 1.55a14.3 14.3 0 0 0 5.4 5.4l1.55-1.85 4.05 1.25v2.6a2 2 0 0 1-2.15 2A15.9 15.9 0 0 1 5.2 5.95a2 2 0 0 1 2-2.15Z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    {% when 'address' %}
                      <svg viewBox="0 0 24 24" focusable="false"><path d="M19 10.2c0 5-7 10.3-7 10.3S5 15.2 5 10.2a7 7 0 1 1 14 0Z" fill="none" stroke="currentColor" stroke-width="1.5"/><circle cx="12" cy="10" r="2.2" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
                    {% else %}
                      <svg viewBox="0 0 24 24" focusable="false"><circle cx="12" cy="12" r="8.5" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M12 7v5l3.2 2" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  {% endcase %}
                </span>
                <div class="contact-detail__content">
                  <h3>{{ detail_heading | escape }}</h3>
                  {% if detail_kind == 'email' %}
                    <a href="mailto:{{ detail_value | escape }}">{{ detail_value | escape }}</a>
                  {% elsif detail_kind == 'phone' %}
                    {% assign phone_href = detail_value | remove: ' ' | remove: '-' | remove: '(' | remove: ')' | remove: '.' %}
                    <a href="tel:{{ phone_href | escape }}">{{ detail_value | escape }}</a>
                  {% else %}
                    <p>{{ detail_value | escape | newline_to_br }}</p>
                  {% endif %}
                  {% if block.settings.note != blank %}<p class="contact-detail__note">{{ block.settings.note | escape }}</p>{% endif %}
                </div>
              </article>
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}

      {% if section.settings.faq_page != blank %}
        <a class="contact-page__help-link" href="{{ section.settings.faq_page.url | escape }}">
          <span>{% if section.settings.faq_link_label != blank %}{{ section.settings.faq_link_label | escape }}{% else %}{{ 'contact.faq_link' | t | escape }}{% endif %}</span>
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><path d="M5 12h13m-5-5 5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      {% endif %}
    </aside>

    <div class="contact-form-card">
      <header class="contact-form-card__header">
        <h2>{{ section.settings.form_heading | escape }}</h2>
        {% if section.settings.form_note != blank %}<p>{{ section.settings.form_note | escape }}</p>{% endif %}
      </header>
      <div class="contact-form">
        {% form 'contact', id: contact_form_id %}
          {% if form.posted_successfully? %}
            <p id="{{ contact_form_id }}-success" class="form-status form-status--success" role="status" tabindex="-1" data-contact-feedback>{{ 'contact.success' | t }}</p>
          {% endif %}
          {% if form.errors %}
            <div id="{{ contact_errors_id }}" class="form-status form-status--error" role="alert" tabindex="-1" data-contact-feedback>
              <p class="form-status__heading">{{ 'contact.error_heading' | t }}</p>
              {{ form.errors | default_errors }}
            </div>
          {% endif %}

          <div class="contact-form__fields">
            <div class="field contact-form__field">
              <label for="ContactName-{{ section.id }}">{{ 'contact.name' | t }}</label>
              <input id="ContactName-{{ section.id }}" type="text" name="contact[name]" value="{{ form.name | escape }}" autocomplete="name">
            </div>
            <div class="field contact-form__field">
              <label for="ContactEmail-{{ section.id }}">{{ 'contact.email' | t }} <span aria-hidden="true">*</span></label>
              <input id="ContactEmail-{{ section.id }}" type="email" name="contact[email]" value="{{ form.email | escape }}" autocomplete="email" autocorrect="off" autocapitalize="off" required aria-required="true"{% if form.errors contains 'email' %} aria-invalid="true" aria-describedby="ContactEmailError-{{ section.id }}"{% endif %}>
              {% if form.errors contains 'email' %}<p id="ContactEmailError-{{ section.id }}" class="field__error">{{ 'contact.email_error' | t }}</p>{% endif %}
            </div>
            <div class="field contact-form__field">
              <label for="ContactPhone-{{ section.id }}">{{ 'contact.phone' | t }}</label>
              <input id="ContactPhone-{{ section.id }}" type="tel" name="contact[phone]" value="{{ form.phone | escape }}" autocomplete="tel">
            </div>
            <div class="field contact-form__field contact-form__field--full">
              <label for="ContactMessage-{{ section.id }}">{{ 'contact.message' | t }} <span aria-hidden="true">*</span></label>
              <textarea id="ContactMessage-{{ section.id }}" name="contact[body]" required aria-required="true"{% if form.errors contains 'body' %} aria-invalid="true" aria-describedby="ContactMessageError-{{ section.id }}"{% endif %}>{{ form.body | escape }}</textarea>
              {% if form.errors contains 'body' %}<p id="ContactMessageError-{{ section.id }}" class="field__error">{{ 'contact.message_error' | t }}</p>{% endif %}
            </div>
          </div>
          <div class="contact-form__footer">
            <p class="contact-form__privacy">{{ 'contact.privacy_note' | t }}</p>
            <button class="button contact-form__submit" type="submit">
              <span>{{ 'contact.submit' | t }}</span>
              <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><path d="M5 12h13m-5-5 5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
          </div>
        {% endform %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.contact.name",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "t:sections.contact.settings.eyebrow", "default": "CONTACT" },
    { "type": "text", "id": "heading", "label": "t:sections.contact.settings.heading", "default": "How can we help?" },
    { "type": "richtext", "id": "body", "label": "t:sections.contact.settings.body", "default": "<p>Questions about an order, a product, or your routine? Send the store team a message.</p>" },
    { "type": "text", "id": "details_heading", "label": "t:sections.contact.settings.details_heading", "default": "A good place to start" },
    { "type": "richtext", "id": "details_body", "label": "t:sections.contact.settings.details_body", "default": "<p>For order questions, include the order number in your message so the store team has context.</p>" },
    { "type": "page", "id": "faq_page", "label": "t:sections.contact.settings.faq_page" },
    { "type": "text", "id": "faq_link_label", "label": "t:sections.contact.settings.faq_link_label", "default": "Visit our FAQs" },
    { "type": "text", "id": "form_heading", "label": "t:sections.contact.settings.form_heading", "default": "Send us a message" },
    { "type": "text", "id": "form_note", "label": "t:sections.contact.settings.form_note", "default": "Fields marked with an asterisk are required." }
  ],
  "blocks": [
    {
      "type": "contact_detail",
      "name": "t:sections.contact.blocks.contact_detail",
      "settings": [
        {
          "type": "select",
          "id": "kind",
          "label": "t:sections.contact.settings.detail_type",
          "options": [
            { "value": "email", "label": "t:sections.contact.settings.detail_types.email" },
            { "value": "phone", "label": "t:sections.contact.settings.detail_types.phone" },
            { "value": "address", "label": "t:sections.contact.settings.detail_types.address" },
            { "value": "hours", "label": "t:sections.contact.settings.detail_types.hours" }
          ],
          "default": "email"
        },
        { "type": "text", "id": "heading", "label": "t:sections.contact.settings.detail_heading" },
        { "type": "textarea", "id": "value", "label": "t:sections.contact.settings.detail_value" },
        { "type": "text", "id": "note", "label": "t:sections.contact.settings.detail_note" }
      ]
    }
  ],
  "presets": [{ "name": "t:sections.contact.name" }]
}
{% endschema %}
