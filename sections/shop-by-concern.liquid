<section class="page-width section-space skin-concern-section" aria-labelledby="SkinConcernTitle-{{ section.id }}">
  <div class="section-intro">
    <div class="section-intro__copy">
      {% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
      <h2 id="SkinConcernTitle-{{ section.id }}" class="section-heading">{{ section.settings.heading | escape }}</h2>
      {% if section.settings.body != blank %}<div class="section-intro__body rich-text">{{ section.settings.body }}</div>{% endif %}
    </div>
  </div>

  {% if section.blocks.size > 0 %}
    <div class="skin-concern-grid" role="list" aria-label="{{ section.settings.heading | escape }}">
      {% for block in section.blocks %}
        {% assign concern_image = block.settings.image %}
        {% assign concern_alt = concern_image.alt | default: block.settings.title %}
        {% assign concern_demo_asset = 'demo-ingredient.jpg' %}
        {% assign concern_demo_width = 928 %}
        {% assign concern_demo_height = 1152 %}
        {% case forloop.index0 %}
          {% when 1 %}{% assign concern_demo_asset = 'demo-product.jpg' %}
          {% when 2 %}
            {% assign concern_demo_asset = 'demo-hero.jpg' %}
            {% assign concern_demo_width = 1264 %}
            {% assign concern_demo_height = 848 %}
        {% endcase %}
        <article class="skin-concern-card" role="listitem" {{ block.shopify_attributes }}>
          <div class="skin-concern-card__media" data-image-ratio="{{ section.settings.image_ratio | escape }}">
            {% if concern_image != blank %}
              {{ concern_image | image_url: width: 1200 | image_tag: alt: concern_alt, widths: '360, 480, 640, 800, 1000, 1200', sizes: '(min-width: 1200px) 30vw, (min-width: 681px) 45vw, 92vw', loading: 'lazy' }}
            {% else %}
              <img src="{{ concern_demo_asset | asset_url }}" alt="{{ 'sections.shop_by_concern.demo_image_alt' | t: concern: block.settings.title | escape }}" width="{{ concern_demo_width }}" height="{{ concern_demo_height }}" loading="lazy" decoding="async">
              <span class="demo-media-label">{{ 'general.demo_image_label' | t }}</span>
            {% endif %}
          </div>
          <div class="skin-concern-card__content">
            <h3>{{ block.settings.title | escape }}</h3>
            {% if block.settings.body != blank %}<div class="skin-concern-card__body rich-text">{{ block.settings.body }}</div>{% endif %}
            {% if block.settings.collection != blank %}
              <a class="skin-concern-card__link" href="{{ block.settings.collection.url | escape }}">
                <span>{{ section.settings.link_label | escape }}</span>
                <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><path d="M5 12h13m-5-5 5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>
            {% endif %}
          </div>
        </article>
      {% endfor %}
    </div>
  {% elsif request.design_mode %}
    <p class="section-empty-note">{{ 'sections.shop_by_concern.empty' | t }}</p>
  {% endif %}
</section>

{% schema %}
{
  "name": "t:sections.shop_by_concern.name",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "t:sections.shop_by_concern.settings.eyebrow", "default": "SHOP BY CONCERN" },
    { "type": "text", "id": "heading", "label": "t:sections.shop_by_concern.settings.heading", "default": "Find a place to begin." },
    { "type": "richtext", "id": "body", "label": "t:sections.shop_by_concern.settings.body", "default": "<p>Explore store-curated topics, then review each product's formula and directions before choosing.</p>" },
    { "type": "text", "id": "link_label", "label": "t:sections.shop_by_concern.settings.link_label", "default": "Explore collection" },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:sections.shop_by_concern.settings.image_ratio",
      "options": [
        { "value": "square", "label": "t:options.image_with_text_ratio.square" },
        { "value": "portrait", "label": "t:options.image_with_text_ratio.portrait" },
        { "value": "landscape", "label": "t:options.image_with_text_ratio.landscape" }
      ],
      "default": "portrait"
    }
  ],
  "blocks": [
    {
      "type": "concern",
      "name": "t:sections.shop_by_concern.blocks.concern",
      "settings": [
        { "type": "text", "id": "title", "label": "t:sections.shop_by_concern.settings.concern_title", "default": "A daily concern" },
        { "type": "richtext", "id": "body", "label": "t:sections.shop_by_concern.settings.concern_body", "default": "<p>Add store-approved guidance and link to a relevant collection.</p>" },
        { "type": "image_picker", "id": "image", "label": "t:sections.shop_by_concern.settings.concern_image" },
        { "type": "collection", "id": "collection", "label": "t:sections.shop_by_concern.settings.concern_collection" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.shop_by_concern.name",
      "blocks": [
        { "type": "concern", "settings": { "title": "Hydration", "body": "<p>Browse store-selected products and formula information for this topic.</p>" } },
        { "type": "concern", "settings": { "title": "Texture", "body": "<p>Review product details and follow the directions listed for each formula.</p>" } },
        { "type": "concern", "settings": { "title": "Uneven tone", "body": "<p>Explore products curated by the store and read their full ingredient information.</p>" } }
      ]
    }
  ]
}
{% endschema %}
