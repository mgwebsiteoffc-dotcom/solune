<section class="page-width section-space" aria-labelledby="RoutineTitle-{{ section.id }}">
  <div class="section-intro">
    <div class="section-intro__copy">
      {% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
      <h2 id="RoutineTitle-{{ section.id }}" class="section-heading">{{ section.settings.heading | escape }}</h2>
      {% if section.settings.body != blank %}<div class="section-intro__body rich-text">{{ section.settings.body }}</div>{% endif %}
    </div>
  </div>
  <div class="routine-list">
    {% for block in section.blocks %}
      <article class="routine-step" {{ block.shopify_attributes }}>
        <span class="routine-step__number">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
        <h3 class="routine-step__title">{{ block.settings.title | escape }}</h3>
        {% if block.settings.body != blank %}<p class="routine-step__body">{{ block.settings.body | escape }}</p>{% endif %}
        {% if block.settings.link != blank and block.settings.link_label != blank %}<a class="button button--text" href="{{ block.settings.link }}">{{ block.settings.link_label | escape }}</a>{% endif %}
      </article>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.routine_steps.name",
  "max_blocks": 5,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "t:sections.routine_steps.settings.eyebrow", "default": "A SIMPLE ORDER" },
    { "type": "text", "id": "heading", "label": "t:sections.routine_steps.settings.heading", "default": "A ritual, made simple." },
    { "type": "richtext", "id": "body", "label": "t:sections.routine_steps.settings.body", "default": "<p>Let the merchant explain how their products fit together. Avoid implying that a routine treats a medical condition.</p>" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "t:sections.routine_steps.blocks.step",
      "settings": [
        { "type": "text", "id": "title", "label": "t:sections.routine_steps.settings.step_title", "default": "Cleanse" },
        { "type": "text", "id": "body", "label": "t:sections.routine_steps.settings.step_body", "default": "Begin with a gentle cleanse." },
        { "type": "text", "id": "link_label", "label": "t:sections.routine_steps.settings.step_link_label" },
        { "type": "url", "id": "link", "label": "t:sections.routine_steps.settings.step_link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.routine_steps.name",
      "blocks": [
        { "type": "step", "settings": { "title": "Cleanse", "body": "Begin with a gentle cleanse." } },
        { "type": "step", "settings": { "title": "Treat", "body": "Layer the formula that fits your routine." } },
        { "type": "step", "settings": { "title": "Moisturize", "body": "Finish with a moisturizer selected for your preferences." } }
      ]
    }
  ]
}
{% endschema %}
