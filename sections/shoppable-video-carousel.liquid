<section class="page-width section-space shoppable-video-section" data-cards-per-row="{{ section.settings.cards_per_row }}" data-caption-scheme="{{ section.settings.caption_scheme }}" aria-labelledby="ShoppableVideosTitle-{{ section.id }}">
  <div class="section-intro shoppable-video-section__intro">
    <div class="section-intro__copy">
      {% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
      <h2 id="ShoppableVideosTitle-{{ section.id }}" class="section-heading">{{ section.settings.heading | escape }}</h2>
      {% if section.settings.body != blank %}<div class="section-intro__body rich-text">{{ section.settings.body }}</div>{% endif %}
    </div>
    {% if section.blocks.size > 1 %}
      <div class="shoppable-video-section__controls" role="group" aria-label="{{ 'accessibility.carousel_controls' | t | escape }}">
        <button class="button button--secondary shoppable-video-section__control" type="button" data-shoppable-video-step="-1" aria-label="{{ 'general.previous' | t | escape }}" aria-controls="ShoppableVideoTrack-{{ section.id }}">←</button>
        <button class="button button--secondary shoppable-video-section__control" type="button" data-shoppable-video-step="1" aria-label="{{ 'general.next' | t | escape }}" aria-controls="ShoppableVideoTrack-{{ section.id }}">→</button>
      </div>
    {% endif %}
  </div>

  {% if section.blocks.size > 0 %}
    <div class="shoppable-video-carousel" data-shoppable-video-track id="ShoppableVideoTrack-{{ section.id }}" role="region" aria-label="{{ section.settings.heading | escape }}">
      {% for block in section.blocks %}
        {% assign shoppable_video_product = block.settings.product %}
        {% if shoppable_video_product == blank %}
          {% for candidate_product in collections['all'].products limit: 12 %}
            {% if candidate_product.available %}
              {% assign shoppable_video_product = candidate_product %}
              {% break %}
            {% endif %}
          {% endfor %}
        {% endif %}
        {% assign shoppable_video_variant = shoppable_video_product.selected_or_first_available_variant %}
        {% assign shoppable_video_price = shoppable_video_variant.price %}
        {% assign shoppable_video_allocation = shoppable_video_variant.selling_plan_allocations.first %}
        {% if shoppable_video_product.requires_selling_plan and shoppable_video_allocation != blank %}
          {% assign shoppable_video_price = shoppable_video_allocation.price %}
        {% endif %}
        {% assign shoppable_video_form_id = 'ShoppableVideoForm-' | append: section.id | append: '-' | append: block.id %}
        {% assign shoppable_video_poster = block.settings.poster %}
        {% if shoppable_video_poster == blank and shoppable_video_product != blank %}
          {% assign shoppable_video_poster = shoppable_video_product.featured_media.preview_image %}
        {% endif %}
        {% assign shoppable_video_can_add = false %}
        {% if shoppable_video_variant.available %}{% assign shoppable_video_can_add = true %}{% endif %}
        {% if shoppable_video_product.requires_selling_plan and shoppable_video_allocation == blank %}{% assign shoppable_video_can_add = false %}{% endif %}

        <article class="shoppable-video-card" {{ block.shopify_attributes }}>
          <div class="shoppable-video-card__media">
            {% if block.settings.video != blank %}
              {{ block.settings.video | video_tag: class: 'shoppable-video-card__video', image_size: '900x', controls: true, autoplay: section.settings.autoplay, loop: section.settings.loop, muted: section.settings.autoplay, playsinline: true, preload: 'metadata' }}
              <button class="shoppable-video-card__play" type="button" data-shoppable-video-play aria-label="{{ 'accessibility.play_video' | t | escape }}">
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M8 5.5v13l10-6.5z" fill="currentColor"/></svg>
              </button>
            {% elsif shoppable_video_poster != blank %}
              {% assign shoppable_video_alt = shoppable_video_poster.alt | default: shoppable_video_product.title | default: section.settings.heading %}
              {{ shoppable_video_poster | image_url: width: 1000 | image_tag: alt: shoppable_video_alt, widths: '320, 480, 640, 800, 1000', sizes: '(min-width: 1025px) 28vw, (min-width: 681px) 40vw, 82vw', loading: 'lazy' }}
              <span class="demo-media-label">{{ 'general.demo_image_label' | t }}</span>
            {% else %}
              <img src="{{ 'demo-product.jpg' | asset_url }}" alt="{{ 'sections.shoppable_video_carousel.demo_image_alt' | t | escape }}" width="928" height="1152" loading="lazy" decoding="async">
              <span class="demo-media-label">{{ 'general.demo_image_label' | t }}</span>
            {% endif %}
          </div>
          <div class="shoppable-video-card__content">
            {% if block.settings.title != blank %}<h3 class="shoppable-video-card__heading">{{ block.settings.title | escape }}</h3>{% elsif shoppable_video_product != blank %}<h3 class="shoppable-video-card__heading">{{ shoppable_video_product.title | escape }}</h3>{% endif %}
            {% if block.settings.caption != blank %}<p class="shoppable-video-card__caption">{{ block.settings.caption | escape }}</p>{% endif %}
            {% if shoppable_video_product != blank %}
              <a class="shoppable-video-card__product" href="{{ shoppable_video_product.url }}">
                <span>{{ shoppable_video_product.title | escape }}</span>
                <span>{% render 'format-money', amount: shoppable_video_price %}</span>
              </a>
              {% form 'product', shoppable_video_product, id: shoppable_video_form_id, class: 'shoppable-video-card__form' %}
                <input type="hidden" name="id" value="{{ shoppable_video_variant.id }}">
                <input type="hidden" name="quantity" value="1">
                {% if shoppable_video_product.requires_selling_plan and shoppable_video_allocation != blank %}
                  <input type="hidden" name="selling_plan" value="{{ shoppable_video_allocation.selling_plan.id }}">
                {% endif %}
                <button class="button" type="submit" name="add" aria-label="{{ 'product.add_to_cart_for' | t: title: shoppable_video_product.title | escape }}"{% unless shoppable_video_can_add %} disabled{% endunless %}>
                  {% if shoppable_video_can_add %}{{ 'product.add_to_cart' | t }}{% else %}{{ 'general.sold_out' | t }}{% endif %}
                </button>
              {% endform %}
            {% endif %}
          </div>
        </article>
      {% endfor %}
    </div>
    {% if section.blocks.size > 1 %}
      <div class="shoppable-video-pagination" data-shoppable-video-pagination role="group" aria-label="{{ 'accessibility.carousel_pagination' | t | escape }}" data-page-label-template="{{ 'general.page_of' | t: current: '__CURRENT__', total: '__TOTAL__' | escape }}"></div>
    {% endif %}
  {% endif %}
</section>

{% schema %}
{
  "name": "t:sections.shoppable_video_carousel.name",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "t:sections.shoppable_video_carousel.settings.eyebrow", "default": "WATCH & SHOP" },
    { "type": "text", "id": "heading", "label": "t:sections.shoppable_video_carousel.settings.heading", "default": "See the ritual in motion." },
    { "type": "richtext", "id": "body", "label": "t:sections.shoppable_video_carousel.settings.body", "default": "<p>Add short product videos and connect each one to a product.</p>" },
    { "type": "checkbox", "id": "autoplay", "label": "t:sections.shoppable_video_carousel.settings.autoplay", "info": "t:sections.shoppable_video_carousel.settings.autoplay_info", "default": false },
    { "type": "checkbox", "id": "loop", "label": "t:sections.shoppable_video_carousel.settings.loop", "default": true },
    {
      "type": "select",
      "id": "cards_per_row",
      "label": "t:sections.shoppable_video_carousel.settings.cards_per_row",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" },
        { "value": "5", "label": "5" }
      ],
      "default": "4"
    },
    {
      "type": "select",
      "id": "caption_scheme",
      "label": "t:sections.shoppable_video_carousel.settings.caption_scheme",
      "options": [
        { "value": "accent", "label": "t:options.shoppable_video_caption_scheme.accent" },
        { "value": "surface", "label": "t:options.shoppable_video_caption_scheme.surface" },
        { "value": "dark", "label": "t:options.shoppable_video_caption_scheme.dark" }
      ],
      "default": "accent"
    }
  ],
  "blocks": [
    {
      "type": "video_product",
      "name": "t:sections.shoppable_video_carousel.blocks.video_product",
      "settings": [
        { "type": "video", "id": "video", "label": "t:sections.shoppable_video_carousel.settings.video" },
        { "type": "image_picker", "id": "poster", "label": "t:sections.shoppable_video_carousel.settings.poster" },
        { "type": "product", "id": "product", "label": "t:sections.shoppable_video_carousel.settings.product" },
        { "type": "text", "id": "title", "label": "t:sections.shoppable_video_carousel.settings.title" },
        { "type": "textarea", "id": "caption", "label": "t:sections.shoppable_video_carousel.settings.caption" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.shoppable_video_carousel.name",
      "blocks": [
        { "type": "video_product" },
        { "type": "video_product" },
        { "type": "video_product" }
      ]
    }
  ]
}
{% endschema %}
