{% assign routine_product_count = 0 %}
{% for block in section.blocks %}
  {% if block.settings.product != blank %}{% assign routine_product_count = routine_product_count | plus: 1 %}{% endif %}
{% endfor %}

{% if routine_product_count > 0 or request.design_mode %}
  <section class="page-width section-space routine-products-section" data-columns="{{ section.settings.columns | escape }}" aria-labelledby="RoutineProductsTitle-{{ section.id }}">
    <div class="section-intro">
      <div class="section-intro__copy">
        {% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
        <h2 id="RoutineProductsTitle-{{ section.id }}" class="section-heading">{{ section.settings.heading | escape }}</h2>
        {% if section.settings.body != blank %}<div class="section-intro__body rich-text">{{ section.settings.body }}</div>{% endif %}
      </div>
    </div>

    <div class="routine-products-grid" role="list" aria-label="{{ section.settings.heading | escape }}">
      {% for block in section.blocks %}
        {% assign routine_product = block.settings.product %}
        {% assign routine_step_label = block.settings.step_label | strip %}
        {% if routine_step_label == blank %}{% capture routine_step_label %}{{ 'sections.routine_products.step_label' | t: number: forloop.index }}{% endcapture %}{% endif %}
        {% if routine_product != blank %}
          {% assign routine_product_image = routine_product.featured_media.preview_image %}
          {% assign routine_product_alt = routine_product.featured_media.alt | default: routine_product.title %}
          <article class="routine-product-card" role="listitem" {{ block.shopify_attributes }}>
            <a class="routine-product-card__media" href="{{ routine_product.url | escape }}" aria-label="{{ 'product.view_details' | t | append: ': ' | append: routine_product.title | escape }}">
              {% if routine_product_image != blank %}
                {{ routine_product_image | image_url: width: 1000 | image_tag: alt: routine_product_alt, widths: '320, 480, 640, 800, 1000', sizes: '(min-width: 1101px) 22vw, (min-width: 1025px) 30vw, 46vw', loading: 'lazy' }}
              {% else %}
                <img src="{{ 'demo-product.jpg' | asset_url }}" alt="{{ 'general.demo_image_alt' | t | escape }}" width="928" height="1152" loading="lazy" decoding="async">
                <span class="demo-media-label">{{ 'general.demo_image_label' | t }}</span>
              {% endif %}
              <span class="routine-product-card__step">{{ routine_step_label | escape }}</span>
            </a>
            <div class="routine-product-card__content">
              <h3><a href="{{ routine_product.url | escape }}">{{ routine_product.title | escape }}</a></h3>
              {% if block.settings.body != blank %}<p class="routine-product-card__body">{{ block.settings.body | escape | newline_to_br }}</p>{% endif %}
              <p class="routine-product-card__price">
                {% if routine_product.price_varies %}{{ 'general.from' | t }} {% endif %}{% render 'format-money', amount: routine_product.price_min %}
              </p>
              <a class="button button--secondary" href="{{ routine_product.url | escape }}">{{ block.settings.link_label | escape }}</a>
            </div>
          </article>
        {% elsif request.design_mode %}
          <article class="routine-product-card routine-product-card--placeholder" role="listitem" {{ block.shopify_attributes }}>
            <div class="routine-product-card__media">
              <img src="{{ 'demo-product.jpg' | asset_url }}" alt="{{ 'sections.routine_products.demo_image_alt' | t | escape }}" width="928" height="1152" loading="lazy" decoding="async">
              <span class="demo-media-label">{{ 'general.demo_image_label' | t }}</span>
              <span class="routine-product-card__step">{{ routine_step_label | escape }}</span>
            </div>
            <div class="routine-product-card__content">
              <h3>{{ 'sections.routine_products.choose_product' | t }}</h3>
              <p class="routine-product-card__body">{{ 'sections.routine_products.choose_product_info' | t }}</p>
            </div>
          </article>
        {% endif %}
      {% endfor %}
    </div>

    {% if section.settings.disclaimer != blank %}<div class="routine-products-disclaimer rich-text">{{ section.settings.disclaimer }}</div>{% endif %}
  </section>
{% endif %}

{% schema %}
{
  "name": "t:sections.routine_products.name",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "t:sections.routine_products.settings.eyebrow", "default": "SHOP THE ROUTINE" },
    { "type": "text", "id": "heading", "label": "t:sections.routine_products.settings.heading", "default": "Products, step by step." },
    { "type": "richtext", "id": "body", "label": "t:sections.routine_products.settings.body", "default": "<p>Choose products for each step and add directions approved for those specific formulas.</p>" },
    {
      "type": "select",
      "id": "columns",
      "label": "t:sections.routine_products.settings.columns",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "3"
    },
    { "type": "richtext", "id": "disclaimer", "label": "t:sections.routine_products.settings.disclaimer", "default": "<p>Use each product only as directed. This guide is not medical advice.</p>" }
  ],
  "blocks": [
    {
      "type": "routine_product",
      "name": "t:sections.routine_products.blocks.routine_product",
      "settings": [
        { "type": "text", "id": "step_label", "label": "t:sections.routine_products.settings.step_label", "default": "Step" },
        { "type": "product", "id": "product", "label": "t:sections.routine_products.settings.product" },
        { "type": "textarea", "id": "body", "label": "t:sections.routine_products.settings.card_body", "default": "Review the product-specific directions and cautions." },
        { "type": "text", "id": "link_label", "label": "t:sections.routine_products.settings.link_label", "default": "Explore product" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.routine_products.name",
      "blocks": [
        { "type": "routine_product", "settings": { "step_label": "01 · Cleanse" } },
        { "type": "routine_product", "settings": { "step_label": "02 · Apply" } },
        { "type": "routine_product", "settings": { "step_label": "03 · Moisturize" } }
      ]
    }
  ]
}
{% endschema %}
