{% assign current_variant = product.selected_or_first_available_variant %}
{% assign current_quantity_min = current_variant.quantity_rule.min | default: 1 %}
{% assign current_quantity_max = current_variant.quantity_rule.max | default: 0 %}
{% assign current_quantity_increment = current_variant.quantity_rule.increment | default: 1 %}
{% assign current_price = current_variant.price %}
{% assign current_compare_at_price = current_variant.compare_at_price %}
{% if product.requires_selling_plan and current_variant.selling_plan_allocations.size > 0 %}
  {% assign initial_selling_plan = current_variant.selling_plan_allocations.first %}
  {% assign current_price = initial_selling_plan.price %}
  {% if initial_selling_plan.compare_at_price > initial_selling_plan.price %}
    {% assign current_compare_at_price = initial_selling_plan.compare_at_price %}
  {% elsif current_variant.compare_at_price > current_variant.price %}
    {% assign current_compare_at_price = current_variant.compare_at_price %}
  {% else %}
    {% assign current_compare_at_price = current_variant.price %}
  {% endif %}
{% endif %}
{% assign product_form_id = 'ProductForm-' | append: section.id %}
{% assign pickup_container_id = 'PickupAvailability-' | append: section.id %}
{% assign product_media_block = section.blocks | where: 'type', 'product_media' | first %}
{% assign product_rating_block = section.blocks | where: 'type', 'rating' | first %}
{% assign product_rating_has_data = false %}
{% if product.metafields.reviews.rating.value != blank and product.metafields.reviews.rating_count.value != blank %}{% assign product_rating_has_data = true %}{% endif %}
{% assign product_media_layout = 'grid' %}
{% assign product_media_gap = 8 %}
{% assign product_media_ratio = 'natural' %}
{% assign product_mobile_layout = 'slider' %}
{% assign product_mobile_controls = 'dots' %}
{% assign product_image_zoom_enabled = true %}
{% assign product_image_zoom_level = 3 %}
{% assign product_video_autoplay = false %}
{% assign product_video_loop = true %}
{% if product_media_block != blank %}
  {% assign product_media_layout = product_media_block.settings.media_layout %}
  {% assign product_media_gap = product_media_block.settings.media_grid_gap %}
  {% assign product_media_ratio = product_media_block.settings.media_ratio %}
  {% assign product_mobile_layout = product_media_block.settings.mobile_gallery_layout %}
  {% assign product_mobile_controls = product_media_block.settings.mobile_gallery_controls %}
  {% assign product_image_zoom_enabled = product_media_block.settings.enable_image_zoom %}
  {% assign product_image_zoom_level = product_media_block.settings.image_zoom_level %}
  {% assign product_video_autoplay = product_media_block.settings.video_autoplay %}
  {% assign product_video_loop = product_media_block.settings.video_loop %}
{% endif %}
{% assign product_gallery_has_thumbnails = false %}
{% if product.media.size > 1 %}
  {% assign product_gallery_has_thumbnails = true %}
{% endif %}
{% assign show_gallery_dots = false %}
{% if product_media_layout == 'dots_carousel' %}
  {% assign show_gallery_dots = true %}
{% elsif product_mobile_layout == 'slider' and product_mobile_controls == 'dots' %}
  {% assign show_gallery_dots = true %}
{% endif %}
{% render 'breadcrumbs', mode: 'visible' %}
<section class="page-width" id="Product-{{ section.id }}" data-product-root data-current-variant-id="{{ current_variant.id }}" data-money-format="{% render 'money-format-string' %}" data-sold-out-label="{{ 'general.sold_out' | t | escape }}" aria-label="{{ product.title | escape }}">
  <div class="product-layout" style="--product-info-width: {{ section.settings.product_info_width }}%;">
    <div class="product-gallery-container" data-desktop-layout="{{ product_media_layout }}" data-mobile-layout="{{ product_mobile_layout }}" data-mobile-controls="{{ product_mobile_controls }}" data-has-thumbnails="{{ product_gallery_has_thumbnails }}" {% if product_media_block != blank %}{{ product_media_block.shopify_attributes }}{% endif %}>
      {% if product_media_layout == 'thumbnails_left' and product.media.size > 1 %}
        {% render 'product-gallery-thumbnails', product: product, section_id: section.id, placement: 'left' %}
      {% endif %}
      <div
        class="product-gallery{% if product_media_layout == 'stacked' %} product-gallery--grid-one{% elsif product_media_layout == 'grid_two' %} product-gallery--grid-two{% elsif product_media_layout == 'grid' %} product-gallery--grid-featured{% else %} product-gallery--carousel{% endif %}{% if product_mobile_layout == 'slider' %} product-gallery--mobile-slider{% endif %}"
        role="region"
        aria-label="{{ 'accessibility.product_gallery' | t }}"
        data-product-gallery
        data-mobile-layout="{{ product_mobile_layout }}"
        data-media-ratio="{{ product_media_ratio }}"
        style="--media-grid-gap: {{ product_media_gap }}px; --media-image-zoom: {{ product_image_zoom_level }};"
      >
      {% for media in product.media %}
        {% assign media_loading = 'lazy' %}
        {% if forloop.first %}{% assign media_loading = 'eager' %}{% endif %}
        <div class="product-gallery__media{% if media.media_type == 'image' %} product-gallery__media--image{% endif %}" id="ProductMedia-{{ section.id }}-{{ media.id }}" data-media-id="{{ media.id }}" data-gallery-index="{{ forloop.index0 }}">
          {% if media.media_type == 'image' %}
            {% assign media_alt = media.alt | default: product.title %}
            {% capture media_focal_style %}object-position: {{ media.preview_image.presentation.focal_point }};{% endcapture %}
            {{ media.preview_image | image_url: width: 1800 | image_tag: alt: media_alt, widths: '360, 480, 640, 800, 1000, 1200, 1500, 1800', sizes: '(min-width: 1025px) 54vw, (min-width: 681px) 50vw, 100vw', loading: media_loading, style: media_focal_style }}
            {% if product_image_zoom_enabled %}
              <button
                class="product-gallery__zoom"
                type="button"
                aria-label="{{ 'product.zoom_image' | t | escape }}"
                aria-pressed="false"
                data-image-zoom
                data-zoom-label="{{ 'product.zoom_image' | t | escape }}"
                data-reset-label="{{ 'product.reset_image_zoom' | t | escape }}"
              >
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="10.8" cy="10.8" r="6.4" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="m16 16 4 4M10.8 7.8v6M7.8 10.8h6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
              </button>
            {% endif %}
          {% else %}
            {{ media | media_tag: image_size: '1200x', controls: true, autoplay: product_video_autoplay, loop: product_video_loop, muted: product_video_autoplay }}
          {% endif %}
        </div>
      {% else %}
        <div class="product-gallery__media product-gallery__media--image product-gallery__media--demo" data-gallery-index="0">
          <img
            src="{{ 'demo-product.jpg' | asset_url }}"
            alt="{{ 'general.demo_image_alt' | t | escape }}"
            width="928"
            height="1152"
            loading="eager"
            decoding="async"
          >
          <span class="demo-media-label">{{ 'general.demo_image_label' | t }}</span>
          {% if product_image_zoom_enabled %}
            <button
              class="product-gallery__zoom"
              type="button"
              aria-label="{{ 'product.zoom_image' | t | escape }}"
              aria-pressed="false"
              data-image-zoom
              data-zoom-label="{{ 'product.zoom_image' | t | escape }}"
              data-reset-label="{{ 'product.reset_image_zoom' | t | escape }}"
            >
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="10.8" cy="10.8" r="6.4" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="m16 16 4 4M10.8 7.8v6M7.8 10.8h6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
            </button>
          {% endif %}
        </div>
      {% endfor %}
      </div>
      {% if product_media_layout == 'thumbnails_bottom' and product.media.size > 1 %}
        {% render 'product-gallery-thumbnails', product: product, section_id: section.id, placement: 'bottom' %}
      {% endif %}
      {% if show_gallery_dots and product.media.size > 1 %}
        <div class="product-gallery__controls product-gallery__controls--dots" data-gallery-controls role="group" aria-label="{{ 'accessibility.product_gallery' | t | escape }}">
          {% for media in product.media %}
            <a class="product-gallery__dot" href="#ProductMedia-{{ section.id }}-{{ media.id }}" data-gallery-dot="{{ forloop.index0 }}" aria-label="{{ 'product.gallery_go_to_media' | t: index: forloop.index | escape }}"{% if forloop.first %} aria-current="true"{% endif %}></a>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <div class="product-information">
      {% for block in section.blocks %}
        {% if block.type == 'product_media' %}
          {% comment %}The product media block is rendered in the gallery column above.{% endcomment %}
        {% elsif block.type == '@app' %}
          <div class="product-block" {{ block.shopify_attributes }}>{% render block %}</div>
        {% else %}
          <div class="product-block product-block--{{ block.type }}"{% if block.type == 'rating' and product_rating_has_data == false %} hidden{% elsif block.type == 'sku' and current_variant.sku == blank %} hidden{% elsif block.type == 'pickup_availability' %} hidden{% endif %} {{ block.shopify_attributes }}>
            {% case block.type %}
              {% when 'product_title' %}
                <h1 class="product-title product-title--{{ block.settings.style | default: 'h1' | escape }}">{{ product.title | escape }}</h1>
                {% if product_rating_block == blank %}{% render 'product-rating', product: product %}{% endif %}
              {% when 'vendor' %}
                {% if product.vendor != blank %}<p class="product-vendor{% if block.settings.style == 'body' %} product-vendor--body{% endif %}">{{ product.vendor | escape }}</p>{% endif %}
              {% when 'price' %}
                <div class="price-line product-price product-price--{{ block.settings.style | default: 'regular' | escape }}">
                  <span class="price__sale{% if current_compare_at_price > current_price %} price--sale{% endif %}" data-product-price>{% render 'format-money', amount: current_price %}</span>
                  <s class="price__compare" data-compare-price{% unless current_compare_at_price > current_price %} hidden{% endunless %}>{% render 'format-money', amount: current_compare_at_price %}</s>
                </div>
                <p class="product-card__meta" data-unit-price{% unless current_variant.unit_price_measurement %} hidden{% endunless %}>
                  <span class="visually-hidden">{{ 'product.unit_price' | t }} </span>
                  <span data-unit-price-amount>{% render 'format-money', amount: current_variant.unit_price %}</span>
                  {% if current_variant.unit_price_measurement %}/ <span data-unit-price-measure>{{ current_variant.unit_price_measurement.reference_value }}{{ current_variant.unit_price_measurement.reference_unit }}</span>{% endif %}
                </p>
                {% if cart.taxes_included %}<p class="product-card__meta">{{ 'product.taxes_included' | t }}</p>{% endif %}
                <p class="product-status" data-variant-status role="status" aria-live="polite" data-available="{{ 'product.available' | t | escape }}" data-unavailable="{{ 'product.unavailable' | t | escape }}" data-plan-unavailable="{{ 'product.subscription_unavailable' | t | escape }}">{% if current_variant.available %}{{ 'product.available' | t }}{% else %}{{ 'product.unavailable' | t }}{% endif %}</p>
              {% when 'variant_picker' %}
                {% render 'product-variant-picker', product: product, section_id: section.id, form_id: product_form_id, selector_style: block.settings.selector_style, swatch_selector_style: block.settings.swatch_selector_style, hide_sold_out_variants: block.settings.hide_sold_out_variants, variant_image_option_names: block.settings.variant_image_option_names, size_chart_page: block.settings.size_chart_page %}
                {% if product.selling_plan_groups.size > 0 %}
                  {% if section.settings.show_selling_plans or product.requires_selling_plan %}
                    <div class="field product-selling-plans">
                    <label for="SellingPlan-{{ section.id }}">{{ 'product.purchase_options' | t }}</label>
                    <select id="SellingPlan-{{ section.id }}" name="selling_plan" form="{{ product_form_id }}" data-selling-plan-select data-requires-selling-plan="{{ product.requires_selling_plan }}"{% if product.requires_selling_plan %} required{% endif %}>
                      <option value="" data-one-time-purchase{% if product.requires_selling_plan == false %} selected{% endif %}{% if product.requires_selling_plan %} disabled{% endif %}>{{ 'product.one_time_purchase' | t }}</option>
                      {% for plan_variant in product.variants %}
                        {% for allocation in plan_variant.selling_plan_allocations %}
                          <option value="{{ allocation.selling_plan.id }}" data-variant-id="{{ plan_variant.id }}" data-price="{{ allocation.price }}" data-compare-at-price="{{ allocation.compare_at_price | default: 0 }}"{% if plan_variant.id != current_variant.id %} hidden disabled{% endif %}{% if product.requires_selling_plan and plan_variant.id == current_variant.id and forloop.first %} selected{% endif %}>
                            {{ allocation.selling_plan.name | escape }} — {% render 'format-money', amount: allocation.price %}
                          </option>
                        {% endfor %}
                      {% endfor %}
                    </select>
                  </div>
                  {% endif %}
                {% endif %}
              {% when 'quantity_selector' %}
                <div class="field product-quantity-selector{% if block.settings.style == 'stepper' %} product-quantity-selector--stepper{% endif %}">
                  <label for="Quantity-{{ section.id }}">{{ 'product.quantity' | t }}</label>
                  {% if block.settings.style == 'stepper' %}
                    <div class="quantity-stepper">
                      <button class="quantity-stepper__button" type="button" data-quantity-step="-1" data-quantity-input="Quantity-{{ section.id }}" aria-label="{{ 'product.decrease_quantity' | t | escape }}">−</button>
                      <input id="Quantity-{{ section.id }}" type="number" name="quantity" value="{{ current_quantity_min }}" min="{{ current_quantity_min }}" step="{{ current_quantity_increment }}"{% if current_quantity_max > 0 %} max="{{ current_quantity_max }}"{% endif %} inputmode="numeric" form="{{ product_form_id }}" data-product-quantity>
                      <button class="quantity-stepper__button" type="button" data-quantity-step="1" data-quantity-input="Quantity-{{ section.id }}" aria-label="{{ 'product.increase_quantity' | t | escape }}">+</button>
                    </div>
                  {% else %}
                    <input id="Quantity-{{ section.id }}" type="number" name="quantity" value="{{ current_quantity_min }}" min="{{ current_quantity_min }}" step="{{ current_quantity_increment }}"{% if current_quantity_max > 0 %} max="{{ current_quantity_max }}"{% endif %} inputmode="numeric" form="{{ product_form_id }}" data-product-quantity>
                  {% endif %}
                </div>
              {% when 'buy_buttons' %}
                {% form 'product', product, id: product_form_id, class: 'product-form' %}
                  {% if product.gift_card? and block.settings.show_gift_card_recipient %}
                    {% render 'gift-card-recipient-form', form: form, section: section %}
                  {% endif %}
                  <button class="button" type="submit" name="add" data-add-to-cart data-add-label="{{ 'product.add_to_cart' | t | escape }}" data-sold-out-label="{{ 'general.sold_out' | t | escape }}" data-plan-unavailable-label="{{ 'product.subscription_unavailable' | t | escape }}"{% unless current_variant.available %} disabled{% endunless %}>
                    {% if current_variant.available %}{{ 'product.add_to_cart' | t }}{% else %}{{ 'general.sold_out' | t }}{% endif %}
                  </button>
                  {% unless product.gift_card? %}
                    {% if block.settings.show_dynamic_checkout %}{{ form | payment_button }}{% endif %}
                    {% if section.settings.show_payment_terms %}{{ form | payment_terms }}{% endif %}
                  {% endunless %}
                {% endform %}
              {% when 'description' %}
                {% if product.description != blank %}
                  {% if block.settings.presentation == 'accordion' %}
                    <details class="product-accordion"{% if block.settings.open_by_default %} open{% endif %}>
                      <summary>{% if block.settings.heading != blank %}{{ block.settings.heading | escape }}{% else %}{{ 'product.description' | t }}{% endif %}</summary>
                      <div class="product-accordion__content rich-text">{{ product.description }}</div>
                    </details>
                  {% else %}
                    <div class="rich-text">{{ product.description }}</div>
                  {% endif %}
                {% endif %}
              {% when 'ingredients' %}
                {% if product.metafields.custom.key_ingredients != blank or product.metafields.custom.inci_list != blank or product.metafields.custom.formula_notes != blank %}
                  <details class="product-accordion"{% if block.settings.open_by_default %} open{% endif %}>
                    <summary>{{ 'product.ingredients' | t }}</summary>
                    <div class="product-accordion__content">
                      {% if product.metafields.custom.key_ingredients != blank %}{{ product.metafields.custom.key_ingredients | metafield_tag }}{% endif %}
                      {% if product.metafields.custom.inci_list != blank %}<h3>{{ 'product.inci_list' | t }}</h3>{{ product.metafields.custom.inci_list | metafield_tag }}{% endif %}
                      {% if product.metafields.custom.formula_notes != blank %}<h3>{{ 'product.formula_notes' | t }}</h3>{{ product.metafields.custom.formula_notes | metafield_tag }}{% endif %}
                    </div>
                  </details>
                {% endif %}
              {% when 'skin_profile' %}
                {% if product.metafields.custom.skin_types != blank or product.metafields.custom.skin_concerns != blank or product.metafields.custom.texture != blank %}
                  <details class="product-accordion"{% if block.settings.open_by_default %} open{% endif %}>
                    <summary>{{ 'product.skin_profile' | t }}</summary>
                    <div class="product-accordion__content">
                      {% if product.metafields.custom.skin_types != blank %}
                        <h3>{{ 'product.skin_types' | t }}</h3>
                        <ul>{% for skin_type in product.metafields.custom.skin_types.value %}<li>{{ skin_type | escape }}</li>{% endfor %}</ul>
                      {% endif %}
                      {% if product.metafields.custom.skin_concerns != blank %}
                        <h3>{{ 'product.skin_concerns' | t }}</h3>
                        <ul>{% for concern in product.metafields.custom.skin_concerns.value %}<li>{{ concern | escape }}</li>{% endfor %}</ul>
                      {% endif %}
                      {% if product.metafields.custom.texture != blank %}<p><strong>{{ 'product.texture' | t }}:</strong> {{ product.metafields.custom.texture.value | default: product.metafields.custom.texture | escape }}</p>{% endif %}
                    </div>
                  </details>
                {% endif %}
              {% when 'usage' %}
                {% if product.metafields.custom.how_to_use != blank or product.metafields.custom.cautions != blank %}
                  <details class="product-accordion"{% if block.settings.open_by_default %} open{% endif %}>
                    <summary>{{ 'product.how_to_use' | t }}</summary>
                    <div class="product-accordion__content">
                      {% if product.metafields.custom.how_to_use != blank %}{{ product.metafields.custom.how_to_use | metafield_tag }}{% endif %}
                      {% if product.metafields.custom.cautions != blank %}<h3>{{ 'product.cautions' | t }}</h3>{{ product.metafields.custom.cautions | metafield_tag }}{% endif %}
                    </div>
                  </details>
                {% endif %}
              {% when 'sku', 'badges', 'rating', 'separator', 'inventory', 'pickup_availability' %}
                {% render 'product-info-merchandising', block: block, product: product, current_variant: current_variant, current_price: current_price, current_compare_at_price: current_compare_at_price, show_pickup_availability: section.settings.show_pickup_availability, pickup_container_id: pickup_container_id %}
              {% when 'product_image', 'button', 'modal', 'share_buttons', 'more_information', 'offers', 'feature_with_icon', 'collapsible_text' %}
                {% render 'product-info-content', block: block, product: product, section_id: section.id %}
              {% when 'pincode_checker' %}
                {% render 'pincode-checker', block: block, section_id: section.id %}
              {% when 'line_item_property' %}
                {% render 'product-line-item-property', block: block, section_id: section.id, product_form_id: product_form_id %}
              {% when 'complementary_products' %}
                {% render 'product-complementary-products', block: block, product: product %}
              {% when 'text' %}
                {% if block.settings.text != blank %}<div class="rich-text product-block-text--{{ block.settings.style | default: 'body' | escape }}">{{ block.settings.text }}</div>{% endif %}
              {% when 'custom_liquid' %}
                {{ block.settings.liquid }}
            {% endcase %}
          </div>
        {% endif %}
      {% endfor %}

    </div>
  </div>
  {% if section.settings.sticky_add_to_cart %}
    <div class="product-sticky-bar" data-product-sticky-bar hidden>
      <div class="product-sticky-bar__details">
        <span class="product-sticky-bar__title">{{ product.title | escape }}</span>
        <span class="product-sticky-bar__price" data-sticky-product-price>{% render 'format-money', amount: current_price %}</span>
      </div>
      <button class="button product-sticky-bar__button" type="submit" form="{{ product_form_id }}" name="add" data-sticky-add-to-cart data-add-label="{{ 'product.add_to_cart' | t | escape }}" data-sold-out-label="{{ 'general.sold_out' | t | escape }}" data-plan-unavailable-label="{{ 'product.subscription_unavailable' | t | escape }}"{% unless current_variant.available %} disabled{% endunless %}>
        {% if current_variant.available %}{{ 'product.add_to_cart' | t }}{% else %}{{ 'general.sold_out' | t }}{% endif %}
      </button>
    </div>
  {% endif %}
  <script type="application/json" data-product-variants>{{ product.variants | json }}</script>
  <script type="application/json" data-product-quantity-rules>
    [
      {%- for quantity_variant in product.variants -%}
        {%- unless forloop.first -%},{%- endunless -%}
        {"id":{{ quantity_variant.id | json }},"min":{{ quantity_variant.quantity_rule.min | default: 1 | json }},"max":{{ quantity_variant.quantity_rule.max | default: 0 | json }},"increment":{{ quantity_variant.quantity_rule.increment | default: 1 | json }}}
      {%- endfor -%}
    ]
  </script>
</section>

{% schema %}
{
  "name": "t:sections.product.name",
  "settings": [
    {
      "type": "range",
      "id": "product_info_width",
      "label": "t:labels.product_info_width",
      "min": 30,
      "max": 55,
      "step": 1,
      "unit": "%",
      "default": 40
    },
    {
      "type": "checkbox",
      "id": "sticky_add_to_cart",
      "label": "t:labels.sticky_add_to_cart",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_selling_plans",
      "label": "t:labels.show_selling_plans",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_payment_terms",
      "label": "t:labels.show_payment_terms",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_pickup_availability",
      "label": "t:labels.show_pickup_availability",
      "default": true
    }
  ],
  "max_blocks": 40,
  "blocks": [
    {
      "type": "product_media",
      "name": "t:blocks.product_media",
      "limit": 1,
      "settings": [
        {
          "type": "select",
          "id": "media_layout",
          "label": "t:labels.product_media_layout",
          "options": [
            { "value": "stacked", "label": "t:options.product_media_layout.grid_one" },
            { "value": "grid_two", "label": "t:options.product_media_layout.grid_two" },
            { "value": "grid", "label": "t:options.product_media_layout.grid_featured" },
            { "value": "thumbnails_left", "label": "t:options.product_media_layout.thumbnails_left" },
            { "value": "thumbnails_bottom", "label": "t:options.product_media_layout.thumbnails_bottom" },
            { "value": "dots_carousel", "label": "t:options.product_media_layout.dots_carousel" }
          ],
          "default": "grid"
        },
        {
          "type": "select",
          "id": "media_ratio",
          "label": "t:labels.product_media_ratio",
          "options": [
            { "value": "natural", "label": "t:options.product_media_ratio.natural" },
            { "value": "square", "label": "t:options.product_media_ratio.square" },
            { "value": "portrait", "label": "t:options.product_media_ratio.portrait" },
            { "value": "landscape", "label": "t:options.product_media_ratio.landscape" }
          ],
          "default": "natural"
        },
        {
          "type": "range",
          "id": "media_grid_gap",
          "label": "t:labels.product_media_gap",
          "min": 0,
          "max": 32,
          "step": 2,
          "unit": "px",
          "default": 8
        },
        {
          "type": "select",
          "id": "mobile_gallery_layout",
          "label": "t:labels.product_media_mobile_layout",
          "options": [
            { "value": "grid", "label": "t:options.product_media_mobile_layout.grid" },
            { "value": "slider", "label": "t:options.product_media_mobile_layout.slider" }
          ],
          "default": "slider"
        },
        {
          "type": "select",
          "id": "mobile_gallery_controls",
          "label": "t:labels.product_media_mobile_controls",
          "options": [
            { "value": "dots", "label": "t:options.product_media_mobile_controls.dots" },
            { "value": "none", "label": "t:options.product_media_mobile_controls.none" }
          ],
          "default": "dots"
        },
        {
