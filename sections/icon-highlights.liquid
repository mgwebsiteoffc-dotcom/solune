<section class="page-width section-space icon-highlights-section" data-columns="{{ section.settings.columns | escape }}" aria-labelledby="IconHighlightsTitle-{{ section.id }}">
  <div class="section-intro">
    <div class="section-intro__copy">
      {% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
      <h2 id="IconHighlightsTitle-{{ section.id }}" class="section-heading">{{ section.settings.heading | escape }}</h2>
      {% if section.settings.body != blank %}<div class="section-intro__body rich-text">{{ section.settings.body }}</div>{% endif %}
    </div>
  </div>

  {% if section.blocks.size > 0 %}
    <ul class="icon-highlight-grid" role="list" aria-label="{{ section.settings.heading | escape }}">
      {% for block in section.blocks %}
        {% assign highlight_content = block.settings.body | strip_html | strip %}
        <li class="icon-highlight-card" {{ block.shopify_attributes }}>
          <span class="icon-highlight-card__icon" aria-hidden="true">{% render 'skincare-icon', icon: block.settings.icon %}</span>
          <div class="icon-highlight-card__content">
            {% if block.settings.heading != blank %}<h3>{{ block.settings.heading | escape }}</h3>{% endif %}
            {% if highlight_content != blank %}<div class="icon-highlight-card__body rich-text">{{ block.settings.body }}</div>{% endif %}
            {% if block.settings.link_label != blank and block.settings.link != blank %}
              <a class="icon-highlight-card__link" href="{{ block.settings.link | escape }}">
                <span>{{ block.settings.link_label | escape }}</span>
                <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><path d="M5 12h13m-5-5 5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>
            {% endif %}
          </div>
        </li>
      {% endfor %}
    </ul>
  {% elsif request.design_mode %}
    <p class="section-empty-note">{{ 'sections.icon_highlights.empty' | t }}</p>
  {% endif %}
</section>

{% schema %}
{
  "name": "t:sections.icon_highlights.name",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "t:sections.icon_highlights.settings.eyebrow", "default": "THE DETAILS MATTER" },
    { "type": "text", "id": "heading", "label": "t:sections.icon_highlights.settings.heading", "default": "Helpful details, made easy to find." },
    { "type": "richtext", "id": "body", "label": "t:sections.icon_highlights.settings.body", "default": "<p>Use these cards for accurate product information and store support details.</p>" },
    {
      "type": "select",
      "id": "columns",
      "label": "t:sections.icon_highlights.settings.columns",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "3"
    }
  ],
  "blocks": [
    {
      "type": "highlight",
      "name": "t:sections.icon_highlights.blocks.highlight",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "t:labels.feature_icon",
          "options": [
            { "value": "leaf", "label": "t:options.feature_icon.leaf" },
            { "value": "drop", "label": "t:options.feature_icon.drop" },
            { "value": "sun", "label": "t:options.feature_icon.sun" },
            { "value": "shield", "label": "t:options.feature_icon.shield" },
            { "value": "clock", "label": "t:options.feature_icon.clock" },
            { "value": "sparkle", "label": "t:options.feature_icon.sparkle" }
          ],
          "default": "leaf"
        },
        { "type": "text", "id": "heading", "label": "t:sections.icon_highlights.settings.card_heading", "default": "A helpful detail" },
        { "type": "richtext", "id": "body", "label": "t:sections.icon_highlights.settings.card_body", "default": "<p>Add a verified product or store detail.</p>" },
        { "type": "text", "id": "link_label", "label": "t:sections.icon_highlights.settings.link_label" },
        { "type": "url", "id": "link", "label": "t:sections.icon_highlights.settings.link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.icon_highlights.name",
      "blocks": [
        { "type": "highlight", "settings": { "icon": "leaf", "heading": "Ingredient details", "body": "<p>Link to the complete ingredient list and formula notes for each product.</p>" } },
        { "type": "highlight", "settings": { "icon": "sparkle", "heading": "Clear directions", "body": "<p>Share product-specific directions and cautions where shoppers can find them.</p>" } },
        { "type": "highlight", "settings": { "icon": "clock", "heading": "Here to help", "body": "<p>Add your store's contact route and customer support hours.</p>" } }
      ]
    }
  ]
}
{% endschema %}
