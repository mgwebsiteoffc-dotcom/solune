<section class="page-width section-space ingredient-index-section" aria-labelledby="IngredientIndexTitle-{{ section.id }}">
  <div class="section-intro">
    <div class="section-intro__copy">
      {% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
      <h2 id="IngredientIndexTitle-{{ section.id }}" class="section-heading">{{ section.settings.heading | escape }}</h2>
      {% if section.settings.body != blank %}<div class="section-intro__body rich-text">{{ section.settings.body }}</div>{% endif %}
    </div>
  </div>

  {% if section.blocks.size > 0 %}
    <div class="ingredient-index-grid" role="list" aria-label="{{ section.settings.heading | escape }}">
      {% for block in section.blocks %}
        {% assign ingredient_name = block.settings.name | strip %}
        {% assign ingredient_initial = ingredient_name | slice: 0, 1 %}
        {% if ingredient_name != blank %}
          <article class="ingredient-index-card" role="listitem" {{ block.shopify_attributes }}>
            <span class="ingredient-index-card__initial" aria-hidden="true">{{ ingredient_initial | escape }}</span>
            <div class="ingredient-index-card__content">
              <h3>{{ ingredient_name | escape }}</h3>
              {% if block.settings.description != blank %}<div class="ingredient-index-card__description rich-text">{{ block.settings.description }}</div>{% endif %}
              {% if block.settings.product != blank %}
                <a class="ingredient-index-card__link" href="{{ block.settings.product.url | escape }}">
                  <span>{{ block.settings.link_label | default: 'sections.ingredient_index.product_link' | t | escape }}</span>
                  <span class="ingredient-index-card__product">{{ block.settings.product.title | escape }}</span>
                </a>
              {% elsif block.settings.link != blank and block.settings.link_label != blank %}
                <a class="ingredient-index-card__link" href="{{ block.settings.link | escape }}">
                  <span>{{ block.settings.link_label | escape }}</span>
                  <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><path d="M5 12h13m-5-5 5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </a>
              {% endif %}
            </div>
          </article>
        {% endif %}
      {% endfor %}
    </div>
  {% elsif request.design_mode %}
    <p class="section-empty-note">{{ 'sections.ingredient_index.empty' | t }}</p>
  {% endif %}
</section>

{% schema %}
{
  "name": "t:sections.ingredient_index.name",
  "max_blocks": 24,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "t:sections.ingredient_index.settings.eyebrow", "default": "FORMULA INDEX" },
    { "type": "text", "id": "heading", "label": "t:sections.ingredient_index.settings.heading", "default": "Explore ingredients." },
    { "type": "richtext", "id": "body", "label": "t:sections.ingredient_index.settings.body", "default": "<p>Browse the ingredient topics selected by the store. Check each product's complete ingredient list, directions, and cautions for formula-specific information.</p>" }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "t:sections.ingredient_index.blocks.ingredient",
      "settings": [
        { "type": "text", "id": "name", "label": "t:sections.ingredient_index.settings.name", "default": "Ingredient name" },
        { "type": "richtext", "id": "description", "label": "t:sections.ingredient_index.settings.description" },
        { "type": "product", "id": "product", "label": "t:sections.ingredient_index.settings.product" },
        { "type": "text", "id": "link_label", "label": "t:sections.ingredient_index.settings.link_label", "default": "View related product" },
        { "type": "url", "id": "link", "label": "t:sections.ingredient_index.settings.link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.ingredient_index.name",
      "blocks": [
        { "type": "ingredient", "settings": { "name": "Ceramides" } },
        { "type": "ingredient", "settings": { "name": "Hyaluronic acid" } },
        { "type": "ingredient", "settings": { "name": "Niacinamide" } },
        { "type": "ingredient", "settings": { "name": "Retinoids" } },
        { "type": "ingredient", "settings": { "name": "Salicylic acid" } },
        { "type": "ingredient", "settings": { "name": "Vitamin C" } }
      ]
    }
  ]
}
{% endschema %}
