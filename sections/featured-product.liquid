{% assign featured_product = section.settings.product %}
{% if featured_product == blank and section.settings.use_first_product_when_empty %}
  {% for candidate_product in collections['all'].products %}
    {% if candidate_product.available %}
      {% assign featured_product = candidate_product %}
      {% break %}
    {% endif %}
  {% endfor %}
{% endif %}
{% if featured_product != blank %}
  {% assign featured_variant = featured_product.selected_or_first_available_variant %}
  {% assign featured_quantity_min = featured_variant.quantity_rule.min | default: 1 %}
  {% assign featured_quantity_max = featured_variant.quantity_rule.max | default: 0 %}
  {% assign featured_quantity_increment = featured_variant.quantity_rule.increment | default: 1 %}
  {% assign featured_price = featured_variant.price %}
  {% assign featured_compare_at_price = featured_variant.compare_at_price %}
  {% if featured_product.requires_selling_plan and featured_variant.selling_plan_allocations.size > 0 %}
    {% assign initial_selling_plan = featured_variant.selling_plan_allocations.first %}
    {% assign featured_price = initial_selling_plan.price %}
    {% if initial_selling_plan.compare_at_price > initial_selling_plan.price %}
      {% assign featured_compare_at_price = initial_selling_plan.compare_at_price %}
    {% elsif featured_variant.compare_at_price > featured_variant.price %}
      {% assign featured_compare_at_price = featured_variant.compare_at_price %}
    {% else %}
      {% assign featured_compare_at_price = featured_variant.price %}
    {% endif %}
  {% endif %}
  {% assign featured_form_id = 'FeaturedProductForm-' | append: section.id %}
  <section id="FeaturedProduct-{{ section.id }}" class="page-width section-space" data-product-root data-money-format="{% if settings.show_currency_code %}{{ shop.money_with_currency_format | escape }}{% else %}{{ shop.money_format | escape }}{% endif %}" data-sold-out-label="{{ 'general.sold_out' | t | escape }}" aria-labelledby="FeaturedProductTitle-{{ section.id }}">
    <div class="product-layout">
      <div class="product-gallery" role="region" aria-label="{{ 'accessibility.product_gallery' | t }}">
        {% for media in featured_product.media limit: 4 %}
          <div class="product-gallery__media" data-media-id="{{ media.id }}">
            {% if media.media_type == 'image' %}
              {% assign media_alt = media.alt | default: featured_product.title %}
              {% capture media_focal_style %}object-position: {{ media.preview_image.presentation.focal_point }};{% endcapture %}
              {{ media.preview_image | image_url: width: 1400 | image_tag: alt: media_alt, widths: '360, 480, 640, 800, 1000, 1200, 1400', sizes: '(min-width: 1025px) 54vw, (min-width: 681px) 50vw, 100vw', loading: 'lazy', style: media_focal_style }}
            {% else %}
              {{ media | media_tag: image_size: '1000x', controls: true }}
            {% endif %}
          </div>
        {% else %}
          <div class="product-gallery__media product-gallery__media--demo">
            <img
              src="{{ 'demo-product.jpg' | asset_url }}"
              alt="{{ 'general.demo_image_alt' | t | escape }}"
              width="928"
              height="1152"
              loading="lazy"
              decoding="async"
            >
            <span class="demo-media-label">{{ 'general.demo_image_label' | t }}</span>
          </div>
        {% endfor %}
      </div>
      <div class="product-information">
        {% for block in section.blocks %}
          {% if block.type == '@app' %}
            <div class="product-block" {{ block.shopify_attributes }}>{% render block %}</div>
          {% else %}
            <div class="product-block product-block--{{ block.type }}" {{ block.shopify_attributes }}>
              {% case block.type %}
                {% when 'title' %}
                  <h2 id="FeaturedProductTitle-{{ section.id }}" class="product-title product-title--{{ block.settings.style | default: 'h2' | escape }}">{{ featured_product.title | escape }}</h2>
                  {% render 'product-rating', product: featured_product %}
                {% when 'price' %}
                  <div class="price-line product-price product-price--{{ block.settings.style | default: 'regular' | escape }}">
                    <span class="{% if featured_compare_at_price > featured_price %}price--sale{% endif %}" data-product-price>{% render 'format-money', amount: featured_price %}</span>
                    <s class="price__compare" data-compare-price{% unless featured_compare_at_price > featured_price %} hidden{% endunless %}>{% render 'format-money', amount: featured_compare_at_price %}</s>
                  </div>
                  <p class="product-card__meta" data-unit-price{% unless featured_variant.unit_price_measurement %} hidden{% endunless %}>
                    <span class="visually-hidden">{{ 'product.unit_price' | t }} </span>
                    <span data-unit-price-amount>{% render 'format-money', amount: featured_variant.unit_price %}</span>
                    {% if featured_variant.unit_price_measurement %}/ <span data-unit-price-measure>{{ featured_variant.unit_price_measurement.reference_value }}{{ featured_variant.unit_price_measurement.reference_unit }}</span>{% endif %}
                  </p>
                  {% if cart.taxes_included %}<p class="product-card__meta">{{ 'product.taxes_included' | t }}</p>{% endif %}
                {% when 'description' %}
                  {% if featured_product.description != blank %}
                    {% if block.settings.presentation == 'accordion' %}
                      <details class="product-accordion"{% if block.settings.open_by_default %} open{% endif %}>
                        <summary>{% if block.settings.heading != blank %}{{ block.settings.heading | escape }}{% else %}{{ 'product.description' | t }}{% endif %}</summary>
                        <div class="product-accordion__content rich-text">{{ featured_product.description }}</div>
                      </details>
                    {% else %}
                      <div class="rich-text">{{ featured_product.description }}</div>
                    {% endif %}
                  {% endif %}
                {% when 'variant_picker' %}
                  {% render 'product-variant-picker', product: featured_product, section_id: section.id, form_id: featured_form_id, selector_style: block.settings.selector_style, swatch_selector_style: block.settings.swatch_selector_style, hide_sold_out_variants: block.settings.hide_sold_out_variants, variant_image_option_names: block.settings.variant_image_option_names, size_chart_page: block.settings.size_chart_page %}
                  {% if featured_product.selling_plan_groups.size > 0 %}
                    {% if section.settings.show_selling_plans or featured_product.requires_selling_plan %}
                      <div class="field product-selling-plans">
                        <label for="FeaturedSellingPlan-{{ section.id }}">{{ 'product.purchase_options' | t }}</label>
                        <select id="FeaturedSellingPlan-{{ section.id }}" name="selling_plan" form="{{ featured_form_id }}" data-selling-plan-select data-requires-selling-plan="{{ featured_product.requires_selling_plan }}"{% if featured_product.requires_selling_plan %} required{% endif %}>
                          <option value="" data-one-time-purchase{% unless featured_product.requires_selling_plan %} selected{% endunless %}{% if featured_product.requires_selling_plan %} disabled{% endif %}>{{ 'product.one_time_purchase' | t }}</option>
                          {% for plan_variant in featured_product.variants %}
                            {% for allocation in plan_variant.selling_plan_allocations %}
                              <option value="{{ allocation.selling_plan.id }}" data-variant-id="{{ plan_variant.id }}" data-price="{{ allocation.price }}" data-compare-at-price="{{ allocation.compare_at_price | default: 0 }}"{% if plan_variant.id != featured_variant.id %} hidden disabled{% endif %}{% if featured_product.requires_selling_plan and plan_variant.id == featured_variant.id and forloop.first %} selected{% endif %}>{{ allocation.selling_plan.name | escape }} — {% render 'format-money', amount: allocation.price %}</option>
                            {% endfor %}
                          {% endfor %}
                        </select>
                      </div>
                    {% endif %}
                  {% endif %}
                {% when 'quantity_selector' %}
                  <div class="field product-quantity-selector{% if block.settings.style == 'stepper' %} product-quantity-selector--stepper{% endif %}">
                    <label for="FeaturedQuantity-{{ section.id }}">{{ 'product.quantity' | t }}</label>
                    {% if block.settings.style == 'stepper' %}
                      <div class="quantity-stepper">
                        <button class="quantity-stepper__button" type="button" data-quantity-step="-1" data-quantity-input="FeaturedQuantity-{{ section.id }}" aria-label="{{ 'product.decrease_quantity' | t | escape }}">−</button>
                        <input id="FeaturedQuantity-{{ section.id }}" type="number" name="quantity" value="{{ featured_quantity_min }}" min="{{ featured_quantity_min }}" step="{{ featured_quantity_increment }}"{% if featured_quantity_max > 0 %} max="{{ featured_quantity_max }}"{% endif %} inputmode="numeric" form="{{ featured_form_id }}" data-product-quantity>
                        <button class="quantity-stepper__button" type="button" data-quantity-step="1" data-quantity-input="FeaturedQuantity-{{ section.id }}" aria-label="{{ 'product.increase_quantity' | t | escape }}">+</button>
                      </div>
                    {% else %}
                      <input id="FeaturedQuantity-{{ section.id }}" type="number" name="quantity" value="{{ featured_quantity_min }}" min="{{ featured_quantity_min }}" step="{{ featured_quantity_increment }}"{% if featured_quantity_max > 0 %} max="{{ featured_quantity_max }}"{% endif %} inputmode="numeric" form="{{ featured_form_id }}" data-product-quantity>
                    {% endif %}
                  </div>
                {% when 'buy_buttons' %}
                  {% form 'product', featured_product, id: featured_form_id, class: 'product-form' %}
                    {% if featured_product.gift_card? and block.settings.show_gift_card_recipient %}
                      {% render 'gift-card-recipient-form', form: form, section: section %}
                    {% endif %}
                    <button class="button" type="submit" name="add" data-add-to-cart data-add-label="{{ 'product.add_to_cart' | t | escape }}" data-sold-out-label="{{ 'general.sold_out' | t | escape }}" data-plan-unavailable-label="{{ 'product.subscription_unavailable' | t | escape }}"{% unless featured_variant.available %} disabled{% endunless %}>{% if featured_variant.available %}{{ 'product.add_to_cart' | t }}{% else %}{{ 'general.sold_out' | t }}{% endif %}</button>
                    {% unless featured_product.gift_card? %}
                      {% if block.settings.show_dynamic_checkout %}{{ form | payment_button }}{% endif %}
                      {% if section.settings.show_payment_terms %}{{ form | payment_terms }}{% endif %}
                    {% endunless %}
                  {% endform %}
                {% when 'text' %}<div class="rich-text product-block-text--{{ block.settings.style | default: 'body' | escape }}">{{ block.settings.text }}</div>
                {% when 'custom_liquid' %}{{ block.settings.liquid }}
              {% endcase %}
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
    <script type="application/json" data-product-variants>{{ featured_product.variants | json }}</script>
    <script type="application/json" data-product-quantity-rules>
      [
        {%- for quantity_variant in featured_product.variants -%}
          {%- unless forloop.first -%},{%- endunless -%}
          {"id":{{ quantity_variant.id | json }},"min":{{ quantity_variant.quantity_rule.min | default: 1 | json }},"max":{{ quantity_variant.quantity_rule.max | default: 0 | json }},"increment":{{ quantity_variant.quantity_rule.increment | default: 1 | json }}}
        {%- endfor -%}
      ]
    </script>
  </section>
{% else %}
  <section class="page-width section-space--small" aria-label="{{ 'sections.featured_product.eyebrow' | t | escape }}">
    <div class="featured-product-demo">
      <div class="featured-product-demo__media">
        <img
          src="{{ 'demo-product.jpg' | asset_url }}"
          alt="{{ 'sections.featured_product.demo_image_alt' | t | escape }}"
          width="928"
          height="1152"
          loading="lazy"
          decoding="async"
        >
        <span class="demo-media-label">{{ 'general.demo_image_label' | t }}</span>
      </div>
      <div class="featured-product-demo__copy">
        <p class="eyebrow">{{ 'sections.featured_product.eyebrow' | t }}</p>
        <h2 class="section-heading">{{ 'sections.featured_product.demo_heading' | t }}</h2>
        <p>{{ 'sections.featured_product.choose_product' | t }}</p>
      </div>
    </div>
  </section>
{% endif %}

{% schema %}
{
  "name": "t:sections.featured_product.name",
  "settings": [
    { "type": "product", "id": "product", "label": "t:sections.featured_product.settings.product" },
    { "type": "checkbox", "id": "use_first_product_when_empty", "label": "t:sections.featured_product.settings.use_first_product_when_empty", "default": false },
    { "type": "checkbox", "id": "show_selling_plans", "label": "t:labels.show_selling_plans", "default": true },
    { "type": "checkbox", "id": "show_payment_terms", "label": "t:labels.show_payment_terms", "default": true }
  ],
  "blocks": [
    { "type": "@app" },
    {
      "type": "title",
      "name": "t:blocks.product_title",
      "limit": 1,
      "settings": [
        {
          "type": "select",
          "id": "style",
          "label": "t:labels.heading_style",
          "options": [
            { "value": "h1", "label": "t:options.product_title_style.h1" },
            { "value": "h2", "label": "t:options.product_title_style.h2" },
            { "value": "h3", "label": "t:options.product_title_style.h3" },
            { "value": "h4", "label": "t:options.product_title_style.h4" }
          ],
          "default": "h2"
        }
      ]
    },
    {
      "type": "price",
      "name": "t:blocks.price",
      "limit": 1,
      "settings": [
        {
          "type": "select",
          "id": "style",
          "label": "t:labels.price_style",
          "options": [
            { "value": "regular", "label": "t:options.price_style.regular" },
            { "value": "large", "label": "t:options.price_style.large" }
          ],
          "default": "regular"
        }
      ]
    },
    {
      "type": "variant_picker",
      "name": "t:blocks.variant_picker",
      "limit": 1,
      "settings": [
        { "type": "checkbox", "id": "hide_sold_out_variants", "label": "t:labels.hide_sold_out_variants", "default": false },
        {
          "type": "select",
          "id": "selector_style",
          "label": "t:labels.selector_style",
          "options": [
            { "value": "block", "label": "t:options.selector_style.block" },
            { "value": "dropdown", "label": "t:options.selector_style.dropdown" }
          ],
          "default": "block"
        },
        {
          "type": "select",
          "id": "swatch_selector_style",
          "label": "t:labels.swatch_selector_style",
          "info": "t:labels.swatch_selector_style_info",
          "options": [
            { "value": "swatch", "label": "t:options.swatch_selector_style.swatch" },
            { "value": "button", "label": "t:options.swatch_selector_style.button" },
            { "value": "dropdown", "label": "t:options.swatch_selector_style.dropdown" }
          ],
          "default": "swatch"
        },
        {
          "type": "text",
          "id": "variant_image_option_names",
          "label": "t:labels.variant_image_option_names",
          "info": "t:labels.variant_image_option_names_info"
        },
        {
          "type": "page",
          "id": "size_chart_page",
          "label": "t:labels.size_chart_page",
          "info": "t:labels.size_chart_page_info"
        }
      ]
    },
    {
      "type": "description",
      "name": "t:blocks.description",
      "limit": 1,
      "settings": [
        {
          "type": "select",
          "id": "presentation",
          "label": "t:labels.description_presentation",
          "options": [
            { "value": "inline", "label": "t:options.description_presentation.inline" },
            { "value": "accordion", "label": "t:options.description_presentation.accordion" }
          ],
          "default": "inline"
        },
        { "type": "text", "id": "heading", "label": "t:labels.description_heading", "default": "Description" },
        { "type": "checkbox", "id": "open_by_default", "label": "t:labels.open_by_default", "default": false }
      ]
    },
    {
      "type": "quantity_selector",
      "name": "t:blocks.quantity_selector",
      "limit": 1,
      "settings": [
        {
          "type": "select",
          "id": "style",
          "label": "t:labels.quantity_style",
          "options": [
            { "value": "field", "label": "t:options.quantity_style.field" },
            { "value": "stepper", "label": "t:options.quantity_style.stepper" }
          ],
          "default": "field"
        }
      ]
    },
    {
      "type": "buy_buttons",
      "name": "t:blocks.buy_buttons",
      "limit": 1,
      "settings": [
        { "type": "checkbox", "id": "show_dynamic_checkout", "label": "t:labels.show_dynamic_checkout", "default": true },
        { "type": "checkbox", "id": "show_gift_card_recipient", "label": "t:labels.show_gift_card_recipient", "default": true }
      ]
    },
    {
      "type": "text",
      "name": "t:blocks.text",
      "settings": [
        { "type": "richtext", "id": "text", "label": "t:labels.body_text", "default": "<p>Share a verified product detail.</p>" },
        {
          "type": "select",
          "id": "style",
          "label": "t:labels.text_style",
          "options": [
            { "value": "body", "label": "t:options.text_style.body" },
            { "value": "lead", "label": "t:options.text_style.lead" },
            { "value": "small", "label": "t:options.text_style.small" }
          ],
          "default": "body"
        }
      ]
    },
    {
      "type": "custom_liquid",
      "name": "t:blocks.custom_liquid",
      "settings": [ { "type": "liquid", "id": "liquid", "label": "t:labels.custom_liquid" } ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.featured_product.name",
      "blocks": [ { "type": "title" }, { "type": "price" }, { "type": "variant_picker" }, { "type": "quantity_selector" }, { "type": "buy_buttons" } ]
    }
  ]
}
{% endschema %}
