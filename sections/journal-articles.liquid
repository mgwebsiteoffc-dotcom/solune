{% assign journal_article_count = 0 %}
{% for block in section.blocks %}
  {% if block.settings.article != blank %}{% assign journal_article_count = journal_article_count | plus: 1 %}{% endif %}
{% endfor %}

{% if journal_article_count > 0 or request.design_mode %}
  <section class="page-width section-space journal-articles-section" data-columns="{{ section.settings.columns | escape }}" aria-labelledby="JournalArticlesTitle-{{ section.id }}">
    <div class="section-intro">
      <div class="section-intro__copy">
        {% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
        <h2 id="JournalArticlesTitle-{{ section.id }}" class="section-heading">{{ section.settings.heading | escape }}</h2>
        {% if section.settings.body != blank %}<div class="section-intro__body rich-text">{{ section.settings.body }}</div>{% endif %}
      </div>
      {% if section.settings.blog != blank and section.settings.view_all_label != blank %}
        <a class="button button--text" href="{{ section.settings.blog.url | escape }}">{{ section.settings.view_all_label | escape }}</a>
      {% endif %}
    </div>

    <div class="journal-articles-grid" role="list" aria-label="{{ section.settings.heading | escape }}">
      {% for block in section.blocks %}
        {% assign journal_article = block.settings.article %}
        {% if journal_article != blank %}
          {% assign journal_image = journal_article.image %}
          {% assign journal_image_alt = journal_image.alt | default: journal_article.title %}
          {% assign journal_excerpt = journal_article.excerpt_or_content | strip_html | strip | truncatewords: section.settings.excerpt_words %}
          <article class="journal-article-card" role="listitem" {{ block.shopify_attributes }}>
            <a class="journal-article-card__media" href="{{ journal_article.url | escape }}" aria-label="{{ 'general.read_more' | t | append: ': ' | append: journal_article.title | escape }}">
              {% if journal_image != blank %}
                {{ journal_image | image_url: width: 1200 | image_tag: alt: journal_image_alt, widths: '320, 480, 640, 800, 1000, 1200', sizes: '(min-width: 1200px) 30vw, (min-width: 681px) 45vw, 92vw', loading: 'lazy' }}
              {% else %}
                <img src="{{ 'demo-ingredient.jpg' | asset_url }}" alt="{{ 'sections.journal_articles.demo_image_alt' | t | escape }}" width="928" height="1152" loading="lazy" decoding="async">
                <span class="demo-media-label">{{ 'general.demo_image_label' | t }}</span>
              {% endif %}
            </a>
            <div class="journal-article-card__content">
              {% if block.settings.kicker != blank %}<p class="eyebrow">{{ block.settings.kicker | escape }}</p>{% endif %}
              {% if section.settings.show_date or section.settings.show_author %}
                <p class="journal-article-card__meta">
                  {% if section.settings.show_date %}{{ journal_article.published_at | time_tag: format: 'date' }}{% endif %}
                  {% if section.settings.show_date and section.settings.show_author %}<span aria-hidden="true"> · </span>{% endif %}
                  {% if section.settings.show_author %}{{ journal_article.author | escape }}{% endif %}
                </p>
              {% endif %}
              <h3><a href="{{ journal_article.url | escape }}">{{ journal_article.title | escape }}</a></h3>
              {% if section.settings.show_excerpt and journal_excerpt != blank %}<p class="journal-article-card__excerpt">{{ journal_excerpt | escape }}</p>{% endif %}
              {% if section.settings.read_more_label != blank %}<a class="journal-article-card__link" href="{{ journal_article.url | escape }}">{{ section.settings.read_more_label | escape }} <span aria-hidden="true">→</span></a>{% endif %}
            </div>
          </article>
        {% elsif request.design_mode %}
          <article class="journal-article-card journal-article-card--placeholder" role="listitem" {{ block.shopify_attributes }}>
            <div class="journal-article-card__media">
              <img src="{{ 'demo-ingredient.jpg' | asset_url }}" alt="{{ 'sections.journal_articles.demo_image_alt' | t | escape }}" width="928" height="1152" loading="lazy" decoding="async">
              <span class="demo-media-label">{{ 'general.demo_image_label' | t }}</span>
            </div>
            <div class="journal-article-card__content">
              <p class="eyebrow">{{ 'sections.journal_articles.choose_article' | t }}</p>
              <h3>{{ 'sections.journal_articles.choose_article' | t }}</h3>
              <p class="journal-article-card__excerpt">{{ 'sections.journal_articles.choose_article_info' | t }}</p>
            </div>
          </article>
        {% endif %}
      {% endfor %}
    </div>
    {% if section.blocks.size == 0 and request.design_mode %}<p class="section-empty-note">{{ 'sections.journal_articles.empty' | t }}</p>{% endif %}
  </section>
{% endif %}

{% schema %}
{
  "name": "t:sections.journal_articles.name",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "t:sections.journal_articles.settings.eyebrow", "default": "FROM THE JOURNAL" },
    { "type": "text", "id": "heading", "label": "t:sections.journal_articles.settings.heading", "default": "Notes for curious minds." },
    { "type": "richtext", "id": "body", "label": "t:sections.journal_articles.settings.body", "default": "<p>Feature published store articles and link to the full information.</p>" },
    { "type": "blog", "id": "blog", "label": "t:sections.journal_articles.settings.blog" },
    { "type": "text", "id": "view_all_label", "label": "t:sections.journal_articles.settings.view_all_label", "default": "Visit the journal" },
    {
      "type": "select",
      "id": "columns",
      "label": "t:sections.journal_articles.settings.columns",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "3"
    },
    { "type": "checkbox", "id": "show_date", "label": "t:sections.journal_articles.settings.show_date", "default": true },
    { "type": "checkbox", "id": "show_author", "label": "t:sections.journal_articles.settings.show_author", "default": false },
    { "type": "checkbox", "id": "show_excerpt", "label": "t:sections.journal_articles.settings.show_excerpt", "default": true },
    { "type": "range", "id": "excerpt_words", "label": "t:sections.journal_articles.settings.excerpt_words", "min": 10, "max": 40, "step": 5, "default": 20 },
    { "type": "text", "id": "read_more_label", "label": "t:sections.journal_articles.settings.read_more_label", "default": "Read article" }
  ],
  "blocks": [
    {
      "type": "journal_article",
      "name": "t:sections.journal_articles.blocks.journal_article",
      "settings": [
        { "type": "article", "id": "article", "label": "t:sections.journal_articles.settings.article" },
        { "type": "text", "id": "kicker", "label": "t:sections.journal_articles.settings.kicker" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.journal_articles.name",
      "blocks": [
        { "type": "journal_article" },
        { "type": "journal_article" },
        { "type": "journal_article" }
      ]
    }
  ]
}
{% endschema %}
