<section class="page-width section-space" aria-labelledby="NotFoundTitle-{{ section.id }}">
  <p class="eyebrow">404</p>
  <h1 id="NotFoundTitle-{{ section.id }}" class="section-heading">{{ '404.title' | t }}</h1>
  <p class="section-intro__body">{{ '404.not_found' | t }}</p>
  <p><a class="button" href="{{ routes.all_products_collection_url }}">{{ '404.back_to_shopping' | t }}</a></p>
</section>

{% schema %}
{
  "name": "t:general.404",
  "settings": [],
  "presets": [{ "name": "t:general.404" }]
}
{% endschema %}
