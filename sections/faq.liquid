<section class="page-width section-space faq-section" aria-labelledby="FaqTitle-{{ section.id }}">
  <div class="section-intro faq-section__intro">
    <div class="section-intro__copy">
      {% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
      <h2 id="FaqTitle-{{ section.id }}" class="section-heading">{{ section.settings.heading | escape }}</h2>
      {% if section.settings.body != blank %}<div class="section-intro__body rich-text">{{ section.settings.body }}</div>{% endif %}
    </div>
  </div>

  {% if section.blocks.size > 0 %}
    <div class="faq-list">
      {% for block in section.blocks %}
        {% if block.settings.question != blank %}
          <details class="faq-item" {{ block.shopify_attributes }}>
            <summary class="faq-item__question">{{ block.settings.question | escape }}</summary>
            {% if block.settings.answer != blank %}<div class="faq-item__answer rich-text">{{ block.settings.answer }}</div>{% endif %}
          </details>
        {% endif %}
      {% endfor %}
    </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "t:sections.faq.name",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "t:sections.faq.settings.eyebrow", "default": "GOOD TO KNOW" },
    { "type": "text", "id": "heading", "label": "t:sections.faq.settings.heading", "default": "Questions, answered." },
    { "type": "richtext", "id": "body", "label": "t:sections.faq.settings.body", "default": "<p>Clear, verified information for your skincare routine and delivery.</p>" }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "t:sections.faq.blocks.question",
      "settings": [
        { "type": "text", "id": "question", "label": "t:labels.question", "default": "How do I choose products for my routine?" },
        { "type": "richtext", "id": "answer", "label": "t:labels.answer", "default": "<p>Review each product's ingredients, intended use, and directions before adding it to your routine. If you have individual skin concerns or a condition, speak with a qualified healthcare professional.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.faq.name",
      "blocks": [
        { "type": "question" },
        { "type": "question", "settings": { "question": "Where can I find ingredient information?", "answer": "<p>Review the ingredient details provided on each product page and compare them with the product packaging. Contact the store if you need clarification.</p>" } },
        { "type": "question", "settings": { "question": "How can I check delivery to my area?", "answer": "<p>Use the PIN code checker on a product page. It uses the store-configured coverage list; final availability and shipping rates are confirmed at checkout.</p>" } }
      ]
    }
  ]
}
{% endschema %}
