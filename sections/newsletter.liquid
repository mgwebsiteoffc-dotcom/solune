{% assign newsletter_form_id = 'NewsletterForm-' | append: section.id %}
<section class="page-width section-space--small newsletter-section" aria-labelledby="NewsletterTitle-{{ section.id }}">
  <div>
    <p class="eyebrow">{{ 'newsletter.eyebrow' | t }}</p>
    <h2 id="NewsletterTitle-{{ section.id }}" class="section-heading">{{ section.settings.heading | escape }}</h2>
    {% if section.settings.body != blank %}<div class="section-intro__body rich-text">{{ section.settings.body }}</div>{% endif %}
  </div>
  <div>
    {% form 'customer', id: newsletter_form_id, class: 'newsletter-form' %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <div class="field">
        <label for="NewsletterEmail-{{ section.id }}">{{ 'newsletter.email' | t }}</label>
        <div class="newsletter-form__row">
          <input id="NewsletterEmail-{{ section.id }}" type="email" name="contact[email]" value="{{ form.email | escape }}" autocomplete="email" autocorrect="off" autocapitalize="off" required>
          <button class="button" type="submit" name="commit">{{ 'newsletter.submit' | t }}</button>
        </div>
      </div>
      <p class="product-card__meta">{{ 'newsletter.consent' | t }}</p>
      {% if form.posted_successfully? %}<p class="form-status" role="status">{{ 'general.newsletter_success' | t }}</p>{% endif %}
      {% if form.errors %}<div class="form-status" role="alert">{{ form.errors | default_errors }}</div>{% endif %}
    {% endform %}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.newsletter.name",
  "settings": [
    { "type": "text", "id": "heading", "label": "t:sections.newsletter.settings.heading", "default": "Notes for your ritual" },
    { "type": "richtext", "id": "body", "label": "t:sections.newsletter.settings.body", "default": "<p>Thoughtful skincare, product notes, and occasional studio updates.</p>" }
  ],
  "presets": [{ "name": "t:sections.newsletter.name" }]
}
{% endschema %}
