{% assign canvas_brightness = settings.color_background | color_brightness %}
{% style %}
  {{ settings.type_primary_font | font_face: font_display: 'swap' }}
  {{ settings.type_primary_font | font_modify: 'weight', 'bold' | font_face: font_display: 'swap' }}
  {{ settings.type_primary_font | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}
  {{ settings.type_primary_font | font_modify: 'weight', 'bold' | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}
  {{ settings.type_display_font | font_face: font_display: 'swap' }}
  {{ settings.type_display_font | font_modify: 'weight', 'bold' | font_face: font_display: 'swap' }}
  {{ settings.type_display_font | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}
  {{ settings.type_display_font | font_modify: 'weight', 'bold' | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}
  :root {
    color-scheme: {% if canvas_brightness < 128 %}dark{% else %}light{% endif %};
    --font-body-family: {{ settings.type_primary_font.family }}, {{ settings.type_primary_font.fallback_families }};
    --font-body-style: {{ settings.type_primary_font.style }};
    --font-body-weight: {{ settings.type_primary_font.weight }};
    --font-display-family: {{ settings.type_display_font.family }}, {{ settings.type_display_font.fallback_families }};
    --font-display-style: {{ settings.type_display_font.style }};
    --font-display-weight: {{ settings.type_display_font.weight }};
    --page-width: {{ settings.max_page_width }};
    --page-margin: {{ settings.page_margin }}px;
    --section-spacing: {{ settings.section_spacing }}px;
    --radius-card: {{ settings.card_radius }}px;
    --radius-control: {{ settings.control_radius }}px;
    --product-card-aspect: {{ settings.product_card_aspect }};
    --color-background: {{ settings.color_background }};
    --color-foreground: {{ settings.color_foreground }};
    --color-surface: {{ settings.color_surface }};
    --color-surface-ink: {{ settings.color_surface_ink }};
    --color-accent: {{ settings.color_accent }};
    --color-accent-ink: {{ settings.color_accent_ink }};
    --color-muted: {{ settings.color_muted }};
    --color-border: {{ settings.color_border }};
  }
{% endstyle %}
