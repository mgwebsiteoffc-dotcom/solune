{% case block.type %}
{% when 'product_image' %}
                {% if block.settings.image != blank %}
                  {% assign product_info_image_alt = block.settings.alt | default: block.settings.image.alt | default: product.title %}
                  <figure class="product-info-image" data-image-ratio="{{ block.settings.ratio }}">
                    {% if block.settings.link != blank %}<a href="{{ block.settings.link | escape }}" aria-label="{{ product_info_image_alt | escape }}">{% endif %}
                    {{ block.settings.image | image_url: width: 1200 | image_tag: alt: product_info_image_alt, widths: '320, 480, 640, 800, 1000, 1200', sizes: '(min-width: 1025px) 34vw, (min-width: 681px) 42vw, 100vw', loading: 'lazy' }}
                    {% if block.settings.link != blank %}</a>{% endif %}
                    {% if block.settings.caption != blank %}<figcaption>{{ block.settings.caption | escape }}</figcaption>{% endif %}
                  </figure>
                {% endif %}
              {% when 'button' %}
                {% if block.settings.label != blank and block.settings.link != blank %}
                  <a class="button{% if block.settings.style == 'secondary' %} button--secondary{% elsif block.settings.style == 'text' %} button--text{% endif %} product-info-button" href="{{ block.settings.link | escape }}"{% if block.settings.open_new_tab %} target="_blank" rel="noopener noreferrer"{% endif %}>{{ block.settings.label | escape }}</a>
                {% endif %}
              {% when 'modal' %}
                {% assign product_modal_id = 'ProductInfoModal-' | append: section_id | append: '-' | append: block.id %}
                {% assign product_modal_plain_content = block.settings.content | strip_html | strip %}
                {% if block.settings.trigger_label != blank and product_modal_plain_content != blank %}
                  <button class="button button--text product-modal-trigger" type="button" aria-haspopup="dialog" aria-controls="{{ product_modal_id }}" data-product-modal-trigger>{{ block.settings.trigger_label | escape }}</button>
                  <dialog class="product-info-modal" id="{{ product_modal_id }}" aria-labelledby="{{ product_modal_id }}-title" data-product-info-modal>
                    <div class="product-info-modal__panel">
                      <div class="product-info-modal__header">
                        <h2 id="{{ product_modal_id }}-title">{{ block.settings.heading | default: block.settings.trigger_label | escape }}</h2>
                        <button class="product-info-modal__close" type="button" aria-label="{{ 'accessibility.close' | t | escape }}" data-product-modal-close>×</button>
                      </div>
                      <div class="product-info-modal__content rich-text">{{ block.settings.content }}</div>
                    </div>
                  </dialog>
                {% endif %}
              {% when 'share_buttons' %}
                {% assign product_share_url = product.url | prepend: request.origin %}
                {% assign product_share_image = product.featured_media.preview_image | image_url: width: 1200 %}
                <div class="product-share" data-product-share>
                  {% if block.settings.heading != blank %}<p class="product-share__heading">{{ block.settings.heading | escape }}</p>{% endif %}
                  <div class="product-share__actions">
                    <button class="button button--secondary" type="button" data-product-copy-link data-share-url="{{ product_share_url | escape }}" data-copy-success="{{ 'product.link_copied' | t | escape }}" data-copy-failed="{{ 'product.link_copy_failed' | t | escape }}">{{ 'product.copy_link' | t }}</button>
                    {% if block.settings.show_native_share %}<button class="button button--secondary" type="button" data-product-native-share data-share-title="{{ product.title | escape }}" data-share-url="{{ product_share_url | escape }}" data-share-error="{{ 'product.share_failed' | t | escape }}">{{ 'product.share' | t }}</button>{% endif %}
                    {% if block.settings.show_facebook %}<a class="product-share__link" href="https://www.facebook.com/sharer/sharer.php?u={{ product_share_url | url_encode }}" target="_blank" rel="noopener noreferrer">{{ 'product.share_facebook' | t }}</a>{% endif %}
                    {% if block.settings.show_pinterest %}<a class="product-share__link" href="https://pinterest.com/pin/create/button/?url={{ product_share_url | url_encode }}&amp;media={{ product_share_image | url_encode }}&amp;description={{ product.title | url_encode }}" target="_blank" rel="noopener noreferrer">{{ 'product.share_pinterest' | t }}</a>{% endif %}
                    {% if block.settings.show_email %}<a class="product-share__link" href="mailto:?subject={{ product.title | url_encode }}&amp;body={{ product_share_url | url_encode }}">{{ 'product.share_email' | t }}</a>{% endif %}
                  </div>
                  <span class="visually-hidden" role="status" data-product-share-status></span>
                </div>
              {% when 'more_information' %}
                {% assign product_more_info_plain_content = block.settings.content | strip_html | strip %}
                {% if block.settings.page != blank or product_more_info_plain_content != blank %}
                  <div class="product-more-information">
                    {% if block.settings.heading != blank %}<h2 class="product-more-information__heading">{{ block.settings.heading | escape }}</h2>{% endif %}
                    {% if product_more_info_plain_content != blank %}<div class="rich-text">{{ block.settings.content }}</div>{% endif %}
                    {% if block.settings.page != blank %}<a class="text-link" href="{{ block.settings.page.url | escape }}">{{ block.settings.link_label | default: block.settings.page.title | escape }}</a>{% endif %}
                  </div>
                {% endif %}
              {% when 'offers' %}
                {% assign product_offer_plain_content = block.settings.content | strip_html | strip %}
                {% assign product_offer_accessible_label = block.settings.heading %}
                {% if product_offer_accessible_label == blank %}{% assign product_offer_accessible_label = 'product.offer_details' | t %}{% endif %}
                {% if product_offer_plain_content != blank or block.settings.link_label != blank and block.settings.link != blank %}
                  <aside class="product-offer" aria-label="{{ product_offer_accessible_label | escape }}">
                    {% if block.settings.heading != blank %}<h2 class="product-offer__heading">{{ block.settings.heading | escape }}</h2>{% endif %}
                    {% if product_offer_plain_content != blank %}<div class="rich-text product-offer__content">{{ block.settings.content }}</div>{% endif %}
                    {% if block.settings.link_label != blank and block.settings.link != blank %}<a class="text-link" href="{{ block.settings.link | escape }}">{{ block.settings.link_label | escape }}</a>{% endif %}
                  </aside>
                {% endif %}
              {% when 'feature_with_icon' %}
                <div class="product-feature">
                  <span class="product-feature__icon" aria-hidden="true">
                    {% case block.settings.icon %}
                      {% when 'drop' %}<svg viewBox="0 0 24 24" focusable="false"><path d="M12 2.5S5.5 10 5.5 14.4a6.5 6.5 0 0 0 13 0C18.5 10 12 2.5 12 2.5Z" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M9 15a3 3 0 0 0 3 3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                      {% when 'sun' %}<svg viewBox="0 0 24 24" focusable="false"><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                      {% when 'shield' %}<svg viewBox="0 0 24 24" focusable="false"><path d="M12 3 19 6v5c0 4.7-2.8 8-7 10-4.2-2-7-5.3-7-10V6l7-3Z" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="m9 12 2 2 4-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                      {% when 'clock' %}<svg viewBox="0 0 24 24" focusable="false"><circle cx="12" cy="12" r="8.5" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M12 7v5l3 2" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                      {% when 'sparkle' %}<svg viewBox="0 0 24 24" focusable="false"><path d="m12 2 1.7 6.3L20 10l-6.3 1.7L12 18l-1.7-6.3L4 10l6.3-1.7L12 2Zm6 13 .8 2.2L21 18l-2.2.8L18 21l-.8-2.2L15 18l2.2-.8L18 15Z" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/></svg>
                      {% else %}<svg viewBox="0 0 24 24" focusable="false"><path d="M19.5 4.5C12 4.5 6 7.7 5 14.4c-.3 2.2 1 4 3.3 4.1 6.8.3 10.7-5.7 11.2-14Z" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M4 21c2.2-5 6-8.7 11-11" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                    {% endcase %}
                  </span>
                  <div class="product-feature__content">
                    {% if block.settings.heading != blank %}<h2>{{ block.settings.heading | escape }}</h2>{% endif %}
                    {% assign product_feature_plain_content = block.settings.content | strip_html | strip %}
                    {% if product_feature_plain_content != blank %}<div class="rich-text">{{ block.settings.content }}</div>{% endif %}
                  </div>
                </div>
              {% when 'collapsible_text' %}
                {% assign product_collapsible_plain_text = block.settings.content | strip_html | strip %}
                {% assign product_collapsible_heading = block.settings.heading %}
                {% if product_collapsible_heading == blank %}{% assign product_collapsible_heading = 'product.additional_details' | t %}{% endif %}
                {% if product_collapsible_plain_text != blank %}
                  <details class="product-accordion product-accordion--custom"{% if block.settings.open_by_default %} open{% endif %}>
                    <summary>{{ product_collapsible_heading | escape }}</summary>
                    <div class="product-accordion__content rich-text">{{ block.settings.content }}</div>
                  </details>
                {% endif %}
              {% endcase %}
