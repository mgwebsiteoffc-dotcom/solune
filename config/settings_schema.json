      },
      {
        "type": "url",
        "id": "social_vimeo_link",
        "label": "t:labels.social_vimeo_link"
      }
    ]
  },
  {
    "name": "t:general.favicon",
    "settings": [
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "t:labels.favicon"
      }
    ]
  },
  {
    "name": "t:general.custom_css",
    "settings": [
      {
        "type": "textarea",
        "id": "custom_css",
        "label": "t:labels.custom_css",
        "info": "t:labels.custom_css_info",
        "default": "/* Add custom CSS here. */"
      }
    ]
  },
  {
    "name": "t:general.theme_style",
    "settings": [
      {
        "type": "paragraph",
        "content": "t:labels.theme_style_info"
      }
    ]
  }
]
