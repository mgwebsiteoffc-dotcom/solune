        "type": "url",
        "id": "social_tiktok_link",
        "label": "t:labels.social_tiktok_link"
      },
      {
        "type": "url",
        "id": "social_youtube_link",
        "label": "t:labels.social_youtube_link"
      },
      {
        "type": "url",
        "id": "social_pinterest_link",
        "label": "t:labels.social_pinterest_link"
      },
      {
        "type": "url",
        "id": "social_twitter_link",
        "label": "t:labels.social_twitter_link"
      },
      {
        "type": "url",
        "id": "social_linkedin_link",
        "label": "t:labels.social_linkedin_link"
      },
      {
        "type": "url",
        "id": "social_snapchat_link",
