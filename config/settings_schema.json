[
  {
    "name": "theme_info",
    "theme_name": "Solune",
    "theme_version": "0.1.0",
    "theme_author": "Sani Kumar, Akestech Infotech Pvt Ltd",
    "theme_documentation_url": "https://github.com/mgwebsiteoffc-dotcom/solune#readme",
    "theme_support_url": "https://github.com/mgwebsiteoffc-dotcom/solune/issues"
  },
  {
    "name": "t:general.branding",
    "settings": [
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "t:labels.favicon"
      }
    ]
  },
  {
    "name": "t:general.typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "type_primary_font",
        "default": "work_sans_n4",
        "label": "t:labels.body_font"
      },
      {
        "type": "font_picker",
        "id": "type_display_font",
        "default": "libre_baskerville_n4",
        "label": "t:labels.display_font"
      }
    ]
  },
  {
    "name": "t:general.colors",
    "settings": [
      {
        "type": "color_palette",
        "id": "colors",
        "default": {
          "canvas": "#F4F1E9",
          "ink": "#20342C",
          "surface": "#EAE6DC",
          "surface_ink": "#20342C",
          "accent": "#C8D78F",
          "accent_ink": "#20342C",
          "muted": "#59635D",
          "border": "#7E847A"
        }
      },
      {
        "type": "color",
        "id": "color_background",
        "default": "{{ settings.colors.canvas }}",
        "label": "t:labels.canvas"
      },
      {
        "type": "color",
        "id": "color_foreground",
        "default": "{{ settings.colors.ink }}",
        "label": "t:labels.ink"
      },
      {
        "type": "color",
        "id": "color_surface",
        "default": "{{ settings.colors.surface }}",
        "label": "t:labels.surface"
      },
      {
        "type": "color",
        "id": "color_surface_ink",
        "default": "{{ settings.colors.surface_ink }}",
        "label": "t:labels.surface_ink"
      },
      {
        "type": "color",
        "id": "color_accent",
        "default": "{{ settings.colors.accent }}",
        "label": "t:labels.accent"
      },
      {
        "type": "color",
        "id": "color_accent_ink",
        "default": "{{ settings.colors.accent_ink }}",
        "label": "t:labels.accent_ink"
      },
      {
        "type": "color",
        "id": "color_muted",
        "default": "{{ settings.colors.muted }}",
        "label": "t:labels.muted"
      },
      {
        "type": "color",
        "id": "color_border",
        "default": "{{ settings.colors.border }}",
        "label": "t:labels.border"
      }
    ]
  },
  {
    "name": "t:general.social_media",
    "settings": [
      { "type": "url", "id": "social_facebook_link", "label": "t:labels.social_facebook_link" },
      { "type": "url", "id": "social_instagram_link", "label": "t:labels.social_instagram_link" },
      { "type": "url", "id": "social_tiktok_link", "label": "t:labels.social_tiktok_link" },
      { "type": "url", "id": "social_youtube_link", "label": "t:labels.social_youtube_link" },
      { "type": "url", "id": "social_pinterest_link", "label": "t:labels.social_pinterest_link" },
      { "type": "url", "id": "social_twitter_link", "label": "t:labels.social_twitter_link" },
      { "type": "url", "id": "social_linkedin_link", "label": "t:labels.social_linkedin_link" },
      { "type": "url", "id": "social_snapchat_link", "label": "t:labels.social_snapchat_link" },
      { "type": "url", "id": "social_vimeo_link", "label": "t:labels.social_vimeo_link" }
    ]
  },
  {
    "name": "t:general.layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "t:labels.page_width",
        "options": [
          { "value": "76rem", "label": "t:options.page_width.narrow" },
          { "value": "90rem", "label": "t:options.page_width.standard" },
          { "value": "100rem", "label": "t:options.page_width.wide" }
        ],
        "default": "90rem"
      },
      {
        "type": "range",
        "id": "page_margin",
        "label": "t:labels.page_margin",
        "min": 12,
        "max": 48,
        "step": 2,
        "unit": "px",
        "default": 24
      },
      {
        "type": "range",
        "id": "section_spacing",
        "label": "t:labels.section_spacing",
        "min": 48,
        "max": 144,
        "step": 8,
        "unit": "px",
        "default": 96
      },
      {
        "type": "range",
        "id": "card_radius",
        "label": "t:labels.card_radius",
        "min": 0,
        "max": 20,
        "step": 2,
        "unit": "px",
        "default": 2
      },
      {
        "type": "range",
        "id": "control_radius",
        "label": "t:labels.control_radius",
        "min": 0,
        "max": 24,
        "step": 2,
        "unit": "px",
        "default": 2
      },
      {
        "type": "select",
        "id": "product_card_aspect",
        "label": "t:labels.product_card_aspect",
        "options": [
          { "value": "0.72", "label": "t:options.product_card_aspect.tall" },
          { "value": "0.82", "label": "t:options.product_card_aspect.portrait" },
          { "value": "1", "label": "t:options.product_card_aspect.square" }
        ],
        "default": "0.82"
      }
    ]
  }
]
