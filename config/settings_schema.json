[
  {
    "name": "theme_info",
    "theme_name": "Solune",
    "theme_version": "0.1.0",
    "theme_author": "Sani Kumar",
    "theme_documentation_url": "https://github.com/mgwebsiteoffc-dotcom/solune#readme",
    "theme_support_url": "https://github.com/mgwebsiteoffc-dotcom/solune/issues"
  },
  {
    "name": "t:general.appearance",
    "settings": [
      {
        "type": "header",
        "content": "t:labels.page_layout"
      },
      {
        "type": "select",
        "id": "max_page_width",
        "label": "t:labels.page_width",
        "options": [
          {
            "value": "76rem",
            "label": "t:options.page_width.narrow"
          },
          {
            "value": "90rem",
            "label": "t:options.page_width.standard"
          },
          {
            "value": "100rem",
            "label": "t:options.page_width.wide"
          }
        ],
        "default": "90rem"
      },
      {
        "type": "range",
        "id": "page_margin",
        "label": "t:labels.page_margin",
        "min": 12,
        "max": 48,
        "step": 2,
        "unit": "px",
        "default": 24
      },
      {
        "type": "range",
        "id": "section_spacing",
        "label": "t:labels.section_spacing",
        "min": 48,
        "max": 144,
        "step": 8,
        "unit": "px",
        "default": 96
      },
      {
        "type": "range",
        "id": "control_radius",
        "label": "t:labels.control_radius",
        "min": 0,
        "max": 24,
        "step": 2,
        "unit": "px",
        "default": 2
      }
    ]
  },
  {
    "name": "t:general.colors",
    "settings": [
      {
        "type": "header",
        "content": "t:labels.color_schemes"
      },
      {
        "type": "color_palette",
        "id": "colors",
        "default": {
          "canvas": "#F4F1E9",
          "ink": "#20342C",
          "surface": "#EAE6DC",
          "surface_ink": "#20342C",
          "accent": "#C8D78F",
          "accent_ink": "#20342C",
          "muted": "#59635D",
          "border": "#7E847A",
          "overlay": "#F4F1E9",
          "overlay_ink": "#20342C",
          "input": "#FFFFFF",
          "input_ink": "#20342C",
          "sale": "#8F3C2F",
          "sale_ink": "#FFFFFF",
          "rating": "#986A22"
        }
      },
      {
        "type": "color",
        "id": "color_background",
        "default": "{{ settings.colors.canvas }}",
        "label": "t:labels.canvas"
      },
      {
        "type": "color",
        "id": "color_foreground",
        "default": "{{ settings.colors.ink }}",
        "label": "t:labels.ink"
      },
      {
        "type": "color",
        "id": "color_surface",
        "default": "{{ settings.colors.surface }}",
        "label": "t:labels.surface"
      },
      {
        "type": "color",
        "id": "color_surface_ink",
        "default": "{{ settings.colors.surface_ink }}",
        "label": "t:labels.surface_ink"
      },
      {
        "type": "color",
        "id": "color_accent",
        "default": "{{ settings.colors.accent }}",
        "label": "t:labels.accent"
      },
      {
        "type": "color",
        "id": "color_accent_ink",
        "default": "{{ settings.colors.accent_ink }}",
        "label": "t:labels.accent_ink"
      },
      {
        "type": "color",
        "id": "color_muted",
        "default": "{{ settings.colors.muted }}",
        "label": "t:labels.muted"
      },
      {
        "type": "color",
        "id": "color_border",
        "default": "{{ settings.colors.border }}",
        "label": "t:labels.border"
      },
      {
        "type": "header",
        "content": "t:labels.modal_drawer_colors"
      },
      {
        "type": "color",
        "id": "color_overlay_background",
        "default": "{{ settings.colors.overlay }}",
        "label": "t:labels.overlay_background"
      },
      {
        "type": "color",
        "id": "color_overlay_ink",
        "default": "{{ settings.colors.overlay_ink }}",
        "label": "t:labels.overlay_ink"
      },
      {
        "type": "color",
        "id": "color_input_background",
        "default": "{{ settings.colors.input }}",
        "label": "t:labels.input_background"
      },
      {
        "type": "color",
        "id": "color_input_ink",
        "default": "{{ settings.colors.input_ink }}",
        "label": "t:labels.input_ink"
      },
      {
        "type": "header",
        "content": "t:labels.product_colors"
      },
      {
        "type": "color",
        "id": "color_sale",
        "default": "{{ settings.colors.sale }}",
        "label": "t:labels.sale"
      },
      {
        "type": "color",
        "id": "color_sale_ink",
        "default": "{{ settings.colors.sale_ink }}",
        "label": "t:labels.sale_ink"
      },
      {
        "type": "color",
        "id": "color_rating",
        "default": "{{ settings.colors.rating }}",
        "label": "t:labels.rating"
      }
    ]
  },
  {
    "name": "t:general.typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "type_primary_font",
        "default": "work_sans_n4",
        "label": "t:labels.body_font"
      },
      {
        "type": "font_picker",
        "id": "type_display_font",
        "default": "libre_baskerville_n4",
        "label": "t:labels.display_font"
      }
    ]
  },
  {
    "name": "t:general.currency_format",
    "settings": [
      {
        "type": "checkbox",
        "id": "show_currency_code",
        "label": "t:labels.show_currency_code",
        "default": false
      }
    ]
  },
  {
    "name": "t:general.animation",
    "settings": [
      {
        "type": "select",
        "id": "animation_style",
        "label": "t:labels.animation_style",
        "options": [
          {
            "value": "none",
            "label": "t:options.animation_style.none"
          },
          {
            "value": "subtle",
            "label": "t:options.animation_style.subtle"
          },
          {
            "value": "expressive",
            "label": "t:options.animation_style.expressive"
          }
        ],
        "default": "subtle"
      }
    ]
  },
  {
    "name": "t:general.color_swatch",
    "settings": [
      {
        "type": "select",
        "id": "swatch_shape",
        "label": "t:labels.swatch_shape",
        "options": [
          {
            "value": "circle",
            "label": "t:options.swatch_shape.circle"
          },
          {
            "value": "rounded",
            "label": "t:options.swatch_shape.rounded"
          },
          {
            "value": "square",
            "label": "t:options.swatch_shape.square"
          }
        ],
        "default": "circle"
      },
      {
        "type": "range",
        "id": "swatch_size",
        "label": "t:labels.swatch_size",
        "min": 28,
        "max": 56,
        "step": 4,
        "unit": "px",
        "default": 44
      },
      {
        "type": "range",
        "id": "swatch_border_width",
        "label": "t:labels.swatch_border_width",
        "min": 0,
        "max": 3,
        "step": 1,
        "unit": "px",
        "default": 1
      }
    ]
  },
  {
    "name": "t:general.product_card",
    "settings": [
      {
        "type": "range",
        "id": "card_radius",
        "label": "t:labels.card_radius",
        "min": 0,
        "max": 20,
        "step": 2,
        "unit": "px",
        "default": 2
      },
      {
        "type": "select",
        "id": "product_card_aspect",
        "label": "t:labels.product_card_aspect",
        "options": [
          {
            "value": "0.72",
            "label": "t:options.product_card_aspect.tall"
          },
          {
            "value": "0.82",
            "label": "t:options.product_card_aspect.portrait"
          },
          {
            "value": "1",
            "label": "t:options.product_card_aspect.square"
          }
        ],
        "default": "0.82"
      },
      {
        "type": "checkbox",
        "id": "product_card_show_vendor",
        "label": "t:labels.product_card_show_vendor",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "product_card_enable_quick_add",
        "label": "t:labels.product_card_enable_quick_add",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "product_card_show_rating",
        "label": "t:labels.product_card_show_rating",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "product_card_show_sale_badge",
        "label": "t:labels.product_card_show_sale_badge",
        "default": true
      },
      {
        "type": "select",
        "id": "product_card_hover_effect",
        "label": "t:labels.product_card_hover_effect",
        "options": [
          {
            "value": "none",
            "label": "t:options.product_card_hover_effect.none"
          },
          {
            "value": "zoom",
            "label": "t:options.product_card_hover_effect.zoom"
          }
        ],
        "default": "zoom"
      }
    ]
  },
  {
    "name": "t:general.cart",
    "settings": [
      {
        "type": "checkbox",
        "id": "cart_drawer_enabled",
        "label": "t:labels.cart_drawer_enabled",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "cart_drawer_free_shipping_enabled",
        "label": "t:labels.cart_drawer_free_shipping_enabled",
        "default": false
      },
      {
        "type": "number",
        "id": "cart_drawer_free_shipping_threshold",
        "label": "t:labels.cart_drawer_free_shipping_threshold",
        "info": "t:labels.cart_drawer_free_shipping_threshold_info",
        "min": 0,
        "max": 100000,
        "default": 75
      },
      {
        "type": "checkbox",
        "id": "cart_show_product_image",
        "label": "t:labels.cart_show_product_image",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "cart_show_vendor",
        "label": "t:labels.cart_show_vendor",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "cart_show_note",
        "label": "t:labels.cart_show_note",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "cart_show_tax_notice",
        "label": "t:labels.cart_show_tax_notice",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "cart_show_shipping_note",
        "label": "t:labels.cart_show_shipping_note",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "cart_show_continue_shopping",
        "label": "t:labels.cart_show_continue_shopping",
        "default": true
      }
    ]
  },
  {
